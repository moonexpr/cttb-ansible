---

# desktop configuration
lightdm_hide_users: true

# look and feel
pic_avatar: avatar-drbu.png
pic_bg: Big-Sur-Day.jpg

# office
libreoffice: true

# nfs
nfs_homes_host: fileserver
nfs_homes_export: /nethomes

# LDAP groups, used for access control
ldap_groups:
  - drbu-students
  - drbu-staff
ldap_guest_string: "(drbu-guests) "
ldap_group_acl_string1: "{% for item in ldap_groups %}({{item}}) {% endfor %}"
# groups.get: drbu_cs_lab_guest only exists in inventory/hosts (and holds the
# pre-sw-cslab machine names); under sudhanix26_hosts.ini it is absent and a
# bare groups[...] lookup fails the whole ldap-client role.
ldap_group_acl_string: "{{ldap_group_acl_string1}}{% if inventory_hostname in groups.get('drbu_cs_lab_guest', []) %}{{ldap_guest_string}}{%endif%}"

# printing settings
cups_srv: cups-cttb

# dictionaries for goldendict
goldendict: true

# Sanskrit support
sanskrit: true

additional_apt_repo:
  - ppa:stellarium/stellarium-releases
 
additional_desktop_sw:
  - stellarium
  - musescore3
  - anki

# Become password for the `administrator` identity on DRBU hosts.
# DRBU uses its own superadmin password rather than the campus-wide one set in
# group_vars/cttb_hosts.yml. This group is a child of cttb_hosts in both
# inventories, so it overrides that value for DRBU hosts only; every non-DRBU
# host keeps the cttb_hosts default. Decrypts automatically via ansible.cfg's
# vault_password_file (utils/vault-pass), so no --ask-become-pass is needed.
ansible_become_password: !vault |
          $ANSIBLE_VAULT;1.1;AES256
          31333636393363393738336262376238313161656336376133313838633764356238616234333362
