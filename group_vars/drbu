---

# desktop configuration
lightdm_hide_users: true

# look and feel
pic_avatar: avatar-drbu.jpg
pic_bg: bg-drbu.png

# office
libreoffice: true

# nfs
nfs_homes_host: nfs-drbu
nfs_homes_export: /export/drbu

# LDAP groups, used for access control
ldap_groups:
  - drbu-students
  - drbu-staff
ldap_guest_string: "(drbu-guests) "
ldap_group_acl_string1: "{% for item in ldap_groups %}({{item}}) {% endfor %}"
ldap_group_acl_string: "{{ldap_group_acl_string1}}{% if inventory_hostname in groups['drbu-cs-lab-guest'] %}{{ldap_guest_string}}{%endif%}"
