---

# nfs homes settings
nfs_homes_host: fileserver
nfs_homes_export: /nethomes

# LDAP groups, used for access control
ldap_groups:
  - dvgs-students
  - dvgs-staff
ldap_group_acl_string: "{% for item in ldap_groups %}({{item}}) {% endfor %}"

# printing settings
cups_srv: cups-dvgs

# desktop configuration
lightdm_hide_users: true

# look and feel
pic_avatar: avatar-dvgs.png
pic_bg: bg-dvgs.jpg
desktop_login_background: bg-dvgs.jpg

# office
openoffice: false
libreoffice: true

# proxy for WAN access (e2guardian → squid on srv-gw)
# e2guardian:8080 is the correct port; blocked during off-hours by timed_internet.sh
global_proxy:
  - "http_proxy=http://10.11.1.1:8080/"
  - "https_proxy=http://10.11.1.1:8080/"
  - "ftp_proxy=http://10.11.1.1:8080/"
  - "no_proxy=localhost,127.0.0.1,10.11.0.0/16,.cttb"
