---

# Locale
locale: en_US.UTF-8

# dns settings
dns_domain: cttb
dns_search: cttb
dns_srv: "10.11.1.29"

# mirros and debian repositories
apt_host: "apt.{{dns_domain}}"
apt_url: "http://apt.{{dns_domain}}"
cttb_repo: "{{apt_url}}/cttb-repos"
deb_mirror: "{{apt_url}}/mirrors"

# for network installations and preseeding
ni_server: "http://pxe.{{dns_domain}}"
ni_www: "{{ni_server}}/netinstall"
ni_preseed: "{{ni_server}}/netinstall/preseed"

# gh-69: single source of truth for the PXE server's IP. The Dell PXE ROM
# on the lab desktops honours the DHCP siaddr field (dnsmasq dhcp-boot=),
# NOT option 66, so the dnsmasq-pxe-boot role renders dhcp-boot= from this.
# A future PXE re-IP is a one-line change here. Matches pxe.cttb's A record
# (pxe24 container's infrastructure-subnet IP since the 2026-05-12 cutover).
pxe_server_ip: "10.11.1.23"

# various assets like isos, fonts, odd packages, etc, basically anything too
# big to fit in a repository
ansible_assets_url: "http://storehouse.{{dns_domain}}/ansible"

ntp_servers:
  - ntp.{{dns_domain}}

# Zoom .deb — served from storehouse so lab machines don't hit zoom.us directly.
# Matches the zoom role's override var in roles/sudhanix-core/tasks/sw.yml.
zoom_deb_url: "{{ansible_assets_url}}/zoom_amd64.deb"

# gh-79: audience-bucketed app sets. Universal, K-12 → university,
# low-controversy base installed on every Sudhanix lab desktop. Per-
# audience additions live in group_vars/{dvbs,dvgs,drbu} as
# sudhanix_apps_extra; per-sub-group additions in
# group_vars/{dvbs_cs_lab,dvgs_cs_lab,drbu_cs_lab,dvgs_art_room} as
# sudhanix_apps_extra_subgroup. NOTE (resolves the issue's "Ansible
# normal group-merge" assumption — which is incorrect for list vars
# without hash_behaviour=merge): the three tiers use DISTINCT var names
# and roles/sudhanix-core/tasks/sw.yml unions them, so a sub-group does
# not clobber its audience's list. Lists below are the issue's concrete
# starting set — tune in review.
sudhanix_apps_base:
  - flameshot
  - qalculate-gtk
  - meld
  - xournalpp
  - pandoc
  - anki
  - calibre
  - foliate
  - krita
  - mypaint
  - obs-studio
  - handbrake
  - stellarium
  - kalzium
  - gnome-games
  - supertux
  - supertuxkart
  - thonny
  - geany
  - git
