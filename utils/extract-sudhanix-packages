#!/usr/bin/env python3
"""
extract-sudhanix-packages — walk the host-agnostic role chain and emit two
flat package lists for the second-stage autoinstaller:

    sudhanix-packages.txt          — every `apt: state=present` package
    sudhanix-packages-remove.txt   — every `apt: state=absent` package

The bootstrap script in sudhanix-autostrap consumes both at install time,
running ONE `apt install -y …` and ONE `apt remove -y --purge …` — replacing
the dozens of per-task apt invocations the role chain would otherwise issue.

Source-of-truth is the role tree. Re-run this on every Sudhanix update; the
play `plays/build-sudhanix-bootstrap-tarball.yml` does so automatically as
part of tarball assembly.

Templated names (`{{ additional_sw | default([]) }}` etc.) are intentionally
DROPPED — they're per-host inventory layers, not bootstrap-baseline
packages. The bulk install covers the core; per-host additions still come
through the operator-side play at finalize time.

Usage:
    extract-sudhanix-packages --repo-root <path> --output-dir <dir>
                              [--roles role1,role2,...]
                              [--verbose]
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path
from typing import Iterable

try:
    import yaml
except ImportError:
    sys.exit("extract-sudhanix-packages: requires PyYAML "
             "(`pip install pyyaml` or `apt install python3-yaml`)")

# Roles the autostrap's `build-sudhanix-autobootstrap.yml` exercises. Update
# this list if the play's `roles:` block changes — the package extraction
# must mirror the same set the autobootstrap actually runs.
DEFAULT_ROLES = (
    "common",                # pulled by sudhanix-core's meta deps
    "sudhanix-core",
    "sudhanix-vajra-tool",   # pulled by sudhanix-core's meta deps
    "time-server",
    "cttb-ca-client",
)


def walk_apt_tasks(node, on_pkg):
    """Recursively yield apt `name:` entries via the `on_pkg(state, name)` cb."""
    if isinstance(node, list):
        for item in node:
            walk_apt_tasks(item, on_pkg)
    elif isinstance(node, dict):
        apt_args = None
        for key in ("apt", "ansible.builtin.apt"):
            v = node.get(key)
            if isinstance(v, dict):
                apt_args = v
                break
        if apt_args is not None:
            _emit_packages(node, apt_args, on_pkg)
        for v in node.values():
            walk_apt_tasks(v, on_pkg)


def _emit_packages(task, apt_args, on_pkg):
    state = apt_args.get("state", "present")
    names = apt_args.get("name", apt_args.get("pkg", apt_args.get("package")))
    if isinstance(names, str):
        names = [names]
    elif names is None:
        # apt task with no `name:` — likely uses `with_items`/`loop`
        loop = task.get("with_items") or task.get("loop")
        names = loop if isinstance(loop, list) else []
    for n in names or []:
        if not isinstance(n, str):
            continue
        if "{{" in n:
            # Templated package name (e.g. `{{ item }}` inside a loop, or
            # an inventory-layer var). Drop — see module docstring.
            continue
        on_pkg(state, n.strip())


def extract(role_dirs: Iterable[Path], verbose: bool = False):
    install, remove = set(), set()

    def collect(state, name):
        target = remove if state in ("absent", "removed") else install
        target.add(name)

    for d in role_dirs:
        if not d.is_dir():
            if verbose:
                print(f"# skip {d}: not a directory", file=sys.stderr)
            continue
        for yml in d.rglob("*.yml"):
            try:
                doc = yaml.safe_load(yml.read_text())
            except yaml.YAMLError as e:
                print(f"# YAML parse error in {yml}: {e}", file=sys.stderr)
                continue
            if doc is None:
                continue
            walk_apt_tasks(doc, collect)
        for yaml_f in d.rglob("*.yaml"):
            try:
                doc = yaml.safe_load(yaml_f.read_text())
            except yaml.YAMLError as e:
                print(f"# YAML parse error in {yaml_f}: {e}", file=sys.stderr)
                continue
            if doc is None:
                continue
            walk_apt_tasks(doc, collect)

    # A package can't be both installed and removed — if it appears in both,
    # absent wins (the role's intent is to ensure it's gone).
    install -= remove
    return sorted(install), sorted(remove)


def write_list(path: Path, header: str, packages: list[str]):
    body = "\n".join(packages)
    path.write_text(
        f"# {header}\n"
        f"# Generated by utils/extract-sudhanix-packages — DO NOT EDIT BY HAND.\n"
        f"# Source of truth is the role tree under roles/.\n"
        f"# {len(packages)} packages.\n"
        f"#\n"
        f"{body}\n"
    )


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo-root", type=Path, default=Path.cwd(),
                    help="cttb-ansible repo root (default: cwd)")
    ap.add_argument("--output-dir", type=Path, required=True,
                    help="directory to write the two .txt files into")
    ap.add_argument("--roles", default=",".join(DEFAULT_ROLES),
                    help=f"comma-separated role names to walk "
                         f"(default: {','.join(DEFAULT_ROLES)})")
    ap.add_argument("--verbose", "-v", action="store_true")
    args = ap.parse_args()

    roles = [args.repo_root / "roles" / r for r in args.roles.split(",") if r]
    args.output_dir.mkdir(parents=True, exist_ok=True)

    install, remove = extract(roles, verbose=args.verbose)

    install_path = args.output_dir / "sudhanix-packages.txt"
    remove_path  = args.output_dir / "sudhanix-packages-remove.txt"

    write_list(install_path,
               "Sudhanix 26 bootstrap — apt install set (host-agnostic)",
               install)
    write_list(remove_path,
               "Sudhanix 26 bootstrap — apt remove set (host-agnostic)",
               remove)

    print(f"wrote {install_path}: {len(install)} install packages")
    print(f"wrote {remove_path}:  {len(remove)} remove packages")
    return 0


if __name__ == "__main__":
    sys.exit(main())
