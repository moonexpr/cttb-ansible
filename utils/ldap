#!/usr/bin/env python3
"""ldap — unified CLI for the CTTB LDAP directory."""
import argparse
import getpass
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent / "sysadmintk"))
import ldap_lib as l


def _ctx(args=None, *, anon: bool = False) -> l.LdapContext:
    """Build a context, honouring --admin when the subcommand offers it."""
    return l.LdapContext.default(anon=anon, admin=getattr(args, "admin", False))


# ── subcommand handlers ───────────────────────────────────────────────────────

def cmd_search(args):
    ctx = _ctx(args, anon=args.anon)
    raw = l.search_raw(ctx, args.filter, args.attrs or [], base=args.base)
    print(raw, end="")


def cmd_group(args):
    ctx = _ctx(args)
    if args.group_cn == "--all" or args.all:
        for g in l.all_groups(ctx):
            g.display()
    else:
        l.group_members(ctx, args.group_cn).display()


def cmd_apply(args):
    ctx = _ctx(args)
    if args.file == "-":
        ldif = sys.stdin.read()
    else:
        ldif = Path(args.file).read_text()
    l.apply_ldif(ctx, ldif, dry_run=not args.risks_confirmed)


def cmd_add_to_group(args):
    ctx = _ctx(args)
    l.add_to_group(ctx, args.uid, args.group, dry_run=not args.risks_confirmed)


def cmd_passwd(args):
    ctx = _ctx(args)
    if sys.stdin.isatty():
        pw1 = getpass.getpass(f"new password for {args.uid}: ")
        pw2 = getpass.getpass("confirm: ")
        if pw1 != pw2:
            print("error: passwords did not match", file=sys.stderr)
            sys.exit(1)
        pw = pw1
    else:
        pw = sys.stdin.readline().rstrip("\n")
    if not pw:
        print("error: empty password", file=sys.stderr)
        sys.exit(1)
    l.reset_password(ctx, args.uid, pw, dry_run=not args.risks_confirmed)


def cmd_add_user(args):
    ctx = _ctx(args)
    l.add_user(
        ctx,
        uid=args.uid,
        cn=args.cn,
        sn=args.sn,
        uid_number=args.uid_number,
        gid_number=args.gid_number,
        given_name=args.given_name or "",
        mail=args.mail or "",
        home=args.home or "",
        shell=args.shell,
        dry_run=not args.risks_confirmed,
    )


# ── parser ────────────────────────────────────────────────────────────────────

def main():
    p = argparse.ArgumentParser(prog="ldap", description="CTTB LDAP directory tool")
    sub = p.add_subparsers(dest="cmd", required=True)

    # search
    sp = sub.add_parser("search", help="run ldapsearch and print LDIF")
    sp.add_argument("-b", dest="base", default=None, metavar="BASE")
    sp.add_argument("--anon", action="store_true", help="anonymous bind")
    sp.add_argument("filter", metavar="FILTER")
    sp.add_argument("attrs", nargs="*", metavar="ATTR")
    sp.add_argument("--admin", action="store_true",
                    help="bind as the directory rootdn (CTTB_LDAP_ADMIN_USERNAME/_PASSWD)")
    sp.set_defaults(func=cmd_search)

    # group
    sp = sub.add_parser("group", help="list posixGroup members (primary + secondary)")
    sp.add_argument("group_cn", metavar="GROUP-CN", help="group cn, or --all")
    sp.add_argument("--all", action="store_true", help="list every group")
    sp.add_argument("--admin", action="store_true",
                    help="bind as the directory rootdn (CTTB_LDAP_ADMIN_USERNAME/_PASSWD)")
    sp.set_defaults(func=cmd_group)

    # apply
    sp = sub.add_parser("apply", help="apply LDIF via ldapmodify (dry-run by default)")
    sp.add_argument("file", metavar="FILE", help="LDIF file path or - for stdin")
    sp.add_argument("--risks-confirmed", action="store_true",
                    help="actually apply (default is dry-run)")
    sp.add_argument("--admin", action="store_true",
                    help="bind as the directory rootdn (CTTB_LDAP_ADMIN_USERNAME/_PASSWD)")
    sp.set_defaults(func=cmd_apply)

    # add-to-group
    sp = sub.add_parser("add-to-group", help="add uid as memberUid of a group")
    sp.add_argument("uid", metavar="UID")
    sp.add_argument("group", metavar="GROUP-CN")
    sp.add_argument("--risks-confirmed", action="store_true")
    sp.add_argument("--admin", action="store_true",
                    help="bind as the directory rootdn (CTTB_LDAP_ADMIN_USERNAME/_PASSWD)")
    sp.set_defaults(func=cmd_add_to_group)

    # passwd
    sp = sub.add_parser("passwd", help="reset a user's password (RFC 3062)")
    sp.add_argument("uid", metavar="UID")
    sp.add_argument("--risks-confirmed", action="store_true",
                    help="actually change (default shows what would happen)")
    sp.add_argument("--admin", action="store_true",
                    help="bind as the directory rootdn (CTTB_LDAP_ADMIN_USERNAME/_PASSWD)")
    sp.set_defaults(func=cmd_passwd)

    # add-user
    sp = sub.add_parser("add-user", help="create posixAccount + inetOrgPerson entry")
    sp.add_argument("--uid", required=True)
    sp.add_argument("--cn", required=True)
    sp.add_argument("--sn", required=True)
    sp.add_argument("--uid-number", required=True, type=int)
    sp.add_argument("--gid-number", required=True, type=int)
    sp.add_argument("--given-name")
    sp.add_argument("--mail")
    sp.add_argument("--home")
    sp.add_argument("--shell", default="/bin/bash")
    sp.add_argument("--risks-confirmed", action="store_true")
    sp.add_argument("--admin", action="store_true",
                    help="bind as the directory rootdn (CTTB_LDAP_ADMIN_USERNAME/_PASSWD)")
    sp.set_defaults(func=cmd_add_user)

    args = p.parse_args()
    try:
        args.func(args)
    except RuntimeError as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
