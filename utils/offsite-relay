#!/usr/bin/env python3
"""offsite-relay — serve campus desktop assets to an off-campus host.

roles/sudhanix-core fetches its theme, font, wallpaper and browser tarballs from
storehouse.cttb. An offsite host cannot reach that; this workstation can (over
Tailscale). So: mirror the tarballs into a local cache, expose that cache to the
target for the duration of a play, and rebind ansible_assets_url to it.

Transport defaults to an SSH REVERSE TUNNEL. The controller and the target are
on different routed subnets, so an inbound connection back to this machine
depends on the gateway's policy and the macOS application firewall. A reverse
tunnel rides the SSH connection we already have and sidesteps both. --direct
binds a LAN address instead, when you know inbound works.

Long term these assets belong on the stage-0 ISO itself (see
create-sudhanix-s0-installer.py), which would reduce this tool to a debug aid.

Usage:
    utils/offsite-relay fetch
    utils/offsite-relay check sc-cslab-pc-right
    utils/offsite-relay run   sc-cslab-pc-right
    utils/offsite-relay run   sc-cslab-pc-right -- --check --tags config
"""
import argparse
import contextlib
import functools
import http.server
import os
import shutil
import socket
import subprocess
import sys
import threading
import urllib.request
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
CACHE = REPO_ROOT / "build" / "offsite-assets"
INVENTORY = "inventory/offsite.ini"
PLAY = "sudhanix26-rollout-stage2-offsite"
DEFAULT_SOURCE = "http://storehouse.cttb/ansible"

# Fetched by sudhanix-core / common with NO rescue: a miss aborts the play.
REQUIRED = [
    "WhiteSur-gtk-theme.tar.gz",
    "InterDisplay.tar.gz",
    "SeriousShannsNerdFontMono.tar.gz",
    "WhiteSur-icon-theme.tar.gz",
    "WhiteSur-cursors.tar.gz",
    "cttb-wallpapers.tar.gz",
    "macos-bigsur-sound-theme.tar.gz",
]
# Wrapped in rescue blocks: a miss silently degrades the desktop instead.
OPTIONAL = [
    "firefox-latest.tar.xz",
    "thunderbird-latest.tar.xz",
    "sudhanix-plymouth.tar.gz",
]
# Excluded by default: zoom via --skip-tags zoom (294 MB), skype via skype=false,
# grub theme via sudhanix_grub_theme_enabled=false.
EXTRA = {
    "zoom": "zoom_amd64.deb",
    "skype": "skypeforlinux-64.deb",
    "grub-theme": "sudhanix-grub-theme.tar.gz",
}


def die(msg):
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def manifest(args) -> list:
    names = REQUIRED + OPTIONAL
    for key, filename in EXTRA.items():
        if getattr(args, "with_" + key.replace("-", "_"), False):
            names.append(filename)
    return names


# ── fetch ─────────────────────────────────────────────────────────────────────


def remote_size(url: str):
    try:
        req = urllib.request.Request(url, method="HEAD")
        with urllib.request.urlopen(req, timeout=15) as r:
            return int(r.headers.get("Content-Length", 0))
    except Exception:
        return None


def fetch(args) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    total = missing = 0
    for name in manifest(args):
        dest = CACHE / name
        url = f"{args.source}/{name}"
        want = remote_size(url)

        if dest.is_file() and not args.force and want and dest.stat().st_size == want:
            print(f"  cached  {name} ({dest.stat().st_size:,} B)")
            total += dest.stat().st_size
            continue
        if want is None:
            print(f"  MISSING {name} — not served by {args.source}")
            missing += 1
            continue

        # Write to .part and rename: an interrupted fetch must never leave a
        # truncated tarball that the target would happily try to extract.
        part = dest.with_suffix(dest.suffix + ".part")
        print(f"  fetch   {name} ({want:,} B) ... ", end="", flush=True)
        try:
            urllib.request.urlretrieve(url, part)
            part.rename(dest)
            print("ok")
            total += dest.stat().st_size
        except Exception as e:
            part.unlink(missing_ok=True)
            print(f"FAILED ({e})")
            missing += 1

    print(f"\nCache {CACHE} — {total / 1e6:.0f} MB")
    absent = [n for n in REQUIRED if not (CACHE / n).is_file()]
    if absent:
        die(f"required assets absent, the play would abort mid-run: {absent}")
    if missing:
        print(f"NOTE: {missing} optional asset(s) unavailable; those tasks will "
              f"fall into their rescue blocks and degrade silently.")


# ── serving ───────────────────────────────────────────────────────────────────


class QuietHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, fmt, *a):
        pass


def start_server(bind: str) -> tuple:
    handler = functools.partial(QuietHandler, directory=str(CACHE))
    httpd = http.server.ThreadingHTTPServer((bind, 0), handler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    return httpd, httpd.server_address[1]


def lan_address_for(target_ip: str) -> str:
    """The local address on the interface that actually routes to the target.

    Binding 0.0.0.0 would also expose the cache on Tailscale and every other
    interface, so resolve the specific address instead.
    """
    out = subprocess.run(["route", "-n", "get", target_ip],
                         capture_output=True, text=True).stdout
    iface = next((l.split(":")[1].strip() for l in out.splitlines()
                  if "interface:" in l), None)
    if not iface:
        die(f"no route to {target_ip}")
    addr = subprocess.run(["ipconfig", "getifaddr", iface],
                          capture_output=True, text=True).stdout.strip()
    if not addr:
        die(f"no IPv4 address on {iface}")
    return addr


def target_ip(host: str) -> str:
    out = subprocess.run(
        ["ansible-inventory", "-i", INVENTORY, "--host", host],
        capture_output=True, text=True, cwd=REPO_ROOT,
    ).stdout
    import json
    try:
        return json.loads(out).get("ansible_host") or host
    except Exception:
        return host


@contextlib.contextmanager
def relay(host: str, direct: bool):
    """Yield the URL the TARGET should use to reach the asset cache."""
    ip = target_ip(host)
    bind = lan_address_for(ip) if direct else "127.0.0.1"
    httpd, port = start_server(bind)
    tunnel = None
    try:
        if direct:
            url = f"http://{bind}:{port}"
            print(f"Relay serving {CACHE.name} on {url} (direct)")
        else:
            # -R binds the port on the TARGET, forwarding back down this SSH
            # connection to our loopback listener.
            tunnel = subprocess.Popen(
                ["ssh", "-N", "-o", "ExitOnForwardFailure=yes",
                 "-o", "BatchMode=yes",
                 "-R", f"{port}:127.0.0.1:{port}", f"administrator@{ip}"],
            )
            url = f"http://127.0.0.1:{port}"
            print(f"Relay serving {CACHE.name} via SSH reverse tunnel; "
                  f"target sees {url}")
        yield url
    finally:
        httpd.shutdown()
        if tunnel:
            tunnel.terminate()
            tunnel.wait(timeout=10)


def check(args) -> None:
    """Prove the target can reach the relay before burning twenty minutes."""
    sentinel = REQUIRED[0]
    with relay(args.target, args.direct) as url:
        ip = target_ip(args.target)
        r = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", f"administrator@{ip}",
             f"curl -sfI {url}/{sentinel} >/dev/null && echo REACHABLE || echo NO"],
            capture_output=True, text=True, timeout=60,
        )
        if "REACHABLE" in r.stdout:
            print(f"OK — {args.target} can fetch {sentinel} from the relay.")
        else:
            die(f"{args.target} cannot reach the relay at {url}. "
                f"{'Try without --direct (reverse tunnel).' if args.direct else 'Check sshd AllowTcpForwarding on the target.'}")


# ── run ───────────────────────────────────────────────────────────────────────


def run(args) -> None:
    fetch(args)
    with relay(args.target, args.direct) as url:
        cmd = ["utils/pb", PLAY, "-l", args.target,
               "--skip-tags", "zoom",
               "-e", f"offsite_asset_relay={url}", *args.options]
        env = {**os.environ, "ANSIBLE_INVENTORY": INVENTORY}
        print(f"\n$ ANSIBLE_INVENTORY={INVENTORY} {' '.join(cmd)}\n")
        rc = subprocess.run(cmd, cwd=REPO_ROOT, env=env).returncode
    sys.exit(rc)


def main() -> None:
    p = argparse.ArgumentParser(prog="offsite-relay", description=__doc__,
                               formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--source", default=DEFAULT_SOURCE, help=f"default {DEFAULT_SOURCE}")
    p.add_argument("--force", action="store_true",
                   help="re-download cached assets instead of trusting size match")
    p.add_argument("--direct", action="store_true",
                   help="bind a LAN address instead of an SSH reverse tunnel")
    for key in EXTRA:
        p.add_argument(f"--with-{key}", action="store_true",
                       help=f"also cache {EXTRA[key]}")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("fetch", help="mirror the asset manifest into the cache")

    sp = sub.add_parser("check", help="prove the target can reach the relay")
    sp.add_argument("target")

    sp = sub.add_parser("serve", help="serve the cache in the foreground")
    sp.add_argument("target")

    sp = sub.add_parser("run", help="fetch, relay, run the play, tear down")
    sp.add_argument("target")
    sp.add_argument("options", nargs="*", help="extra ansible-playbook args after --")

    args = p.parse_args()

    if not shutil.which("ansible-playbook"):
        die("ansible-playbook not on PATH")

    if args.cmd == "fetch":
        fetch(args)
    elif args.cmd == "check":
        check(args)
    elif args.cmd == "serve":
        with relay(args.target, args.direct) as url:
            print(f"Serving at {url} — Ctrl-C to stop.")
            threading.Event().wait()
    elif args.cmd == "run":
        run(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
