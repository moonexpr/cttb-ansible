{# xfce4-notifyd.xml.j2 — notification daemon policy.
   Captured from administrator@dvgs-testmachine 2026-05-06.
#}
<?xml version="1.0" encoding="UTF-8"?>

<channel name="xfce4-notifyd" version="1.0">
  <property name="log-max-size-enabled" type="bool" value="true"/>
  <property name="applications" type="empty">
    <property name="known_applications" type="array">
      <value type="string" value="org.freedesktop.network-manager-applet"/>
      <value type="string" value="thunderbird"/>
      <value type="string" value="xfce4-settings-helper"/>
    </property>
  </property>
  <property name="plugin" type="empty">
    <property name="show-in-menu" type="string" value="show-unread"/>
    <property name="log-only-today" type="bool" value="false"/>
  </property>
</channel>
