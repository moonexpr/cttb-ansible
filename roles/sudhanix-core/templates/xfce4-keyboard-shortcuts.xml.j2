<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="custom" type="empty">
      <!-- Super_L points at xfce4-popup-whiskermenu (Path B from #36 — the
           whiskermenu plugin installed at fb1174d7). Whiskermenu's own
           popup binary toggles open/close on repeated invocation, which
           sidesteps the GTK XGrabKeyboard masking that the wrapper-based
           approach hit on the xfce4-panel applicationsmenu plugin. -->
      <property name="Super_L" type="string" value="xfce4-popup-whiskermenu"/>
      <property name="&lt;Super&gt;l" type="string" value="xflock4"/>
      <property name="&lt;Super&gt;space" type="string" value="xfce4-appfinder"/>
    </property>
  </property>
  <property name="xfwm4" type="empty">
    <property name="custom" type="empty">
      <!-- Task switcher. Replacing xfwm4/custom in xfconf wipes the
           upstream <Alt>Tab default, so bind explicitly here. -->
      <property name="&lt;Alt&gt;Tab" type="string" value="cycle_windows_key"/>
      <property name="&lt;Alt&gt;&lt;Shift&gt;Tab" type="string" value="cycle_reverse_windows_key"/>
      <property name="&lt;Super&gt;Left" type="string" value="tile_left_key"/>
      <property name="&lt;Super&gt;Right" type="string" value="tile_right_key"/>
      <property name="&lt;Super&gt;Up" type="string" value="maximize_window_key"/>
      <property name="&lt;Super&gt;Down" type="string" value="tile_down_key"/>
      <property name="&lt;Primary&gt;w" type="string" value="close_window_key"/>
    </property>
  </property>
</channel>
