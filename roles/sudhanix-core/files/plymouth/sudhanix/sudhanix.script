#
# Sudhanix Plymouth boot splash
# macOS-style: black background, centered Amitabha logo, thin progress bar below.
#

# Pure black background
Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# ── Amitabha logo ─────────────────────────────────────────────────────────
# Render at ~22% of screen height (matches Apple's relative sizing).
logo.image_raw = Image("amitabha.png");
logo_target_h = screen_h * 0.22;
logo_scale = logo_target_h / logo.image_raw.GetHeight();
logo.image = logo.image_raw.Scale(logo.image_raw.GetWidth() * logo_scale, logo_target_h);
logo.sprite = Sprite(logo.image);
logo.x = (screen_w - logo.image.GetWidth()) / 2;
logo.y = (screen_h - logo.image.GetHeight()) / 2 - screen_h * 0.04;
logo.sprite.SetPosition(logo.x, logo.y, 0);

# ── Progress bar ──────────────────────────────────────────────────────────
# Thin white bar centered below the logo, ~50px gap.
bar_bg.image = Image("progress-bg.png");
bar_bg.sprite = Sprite(bar_bg.image);
bar_bg.x = (screen_w - bar_bg.image.GetWidth()) / 2;
bar_bg.y = logo.y + logo.image.GetHeight() + screen_h * 0.06;
bar_bg.sprite.SetPosition(bar_bg.x, bar_bg.y, 1);

bar_fill.image = Image("progress-fill.png");
bar_fill.sprite = Sprite();
bar_fill.sprite.SetPosition(bar_bg.x, bar_bg.y, 2);

fun boot_progress_cb(duration, progress) {
    fill_w = bar_fill.image.GetWidth() * progress;
    if (fill_w < 1) fill_w = 1;
    bar_fill.sprite.SetImage(bar_fill.image.Crop(0, 0, fill_w, bar_fill.image.GetHeight()));
}
Plymouth.SetBootProgressFunction(boot_progress_cb);

# ── Message handling (recovery/text prompts) ──────────────────────────────
# Render any plymouth message centered below the progress bar.
message_sprite = Sprite();
message_sprite.SetPosition(0, bar_bg.y + screen_h * 0.04, 3);

fun display_message_cb(text) {
    img = Image.Text(text, 1, 1, 1, 1, "Sans 12");
    message_sprite.SetImage(img);
    message_sprite.SetX((screen_w - img.GetWidth()) / 2);
}
Plymouth.SetMessageFunction(display_message_cb);

fun hide_message_cb(text) {
    message_sprite.SetImage(Image.Null());
}
Plymouth.SetHideMessageFunction(hide_message_cb);

# ── Password prompt (full-disk encryption) ────────────────────────────────
prompt_sprite = Sprite();
prompt_sprite.SetPosition(0, bar_bg.y + screen_h * 0.04, 4);

fun display_password_cb(prompt, bullets) {
    label = prompt;
    if (label == "") label = "Password:";
    bullets_str = "";
    for (i = 0; i < bullets; i++) bullets_str += "•";
    img = Image.Text(label + " " + bullets_str, 1, 1, 1, 1, "Sans 12");
    prompt_sprite.SetImage(img);
    prompt_sprite.SetX((screen_w - img.GetWidth()) / 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
    prompt_sprite.SetImage(Image.Null());
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);
