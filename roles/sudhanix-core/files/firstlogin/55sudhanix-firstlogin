# /etc/X11/Xsession.d/55sudhanix-firstlogin
#
# Sourced by /etc/X11/Xsession before the user's window manager (xfce4-session)
# starts. Running migration + first-time setup HERE means xfce4-session reads
# the already-bootstrapped home — the user's first session is themed
# correctly, no "second login to look right" experience.
#
# Order in the X session pipeline (Sudhanix 26):
#   1. /etc/X11/Xsession.d/55sudhanix-firstlogin   <- migration + first-setup (this file)
#   2. /usr/bin/xfce4-session                      <- window manager + xfsettingsd read xfconf
#   3. /etc/xdg/autostart/sudhanix-welcome.desktop <- welcome window
#
# Sourced (not exec'd) per the Xsession.d contract; therefore must not call
# `exit`. We delegate to a subshell so set/unset/state changes don't leak
# into the rest of Xsession.

if [ -r /usr/local/lib/sudhanix-firstlogin-lib.sh ] && [ -x /usr/local/sbin/sudhanix-firstlogin ]; then
    /usr/local/sbin/sudhanix-firstlogin || true
fi
