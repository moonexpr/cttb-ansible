SIDEBAR_NAV = (
    (PAGE_WELCOME,       "Welcome",       "sidebar-house"),
    (PAGE_WHATS_NEW,     "What’s new",    "sidebar-sparkle"),
    (PAGE_QUICK_TOUR,    "Quick tour",    "sidebar-compass"),
