        browser_lbl.get_style_context().add_class("dim-label")
        browser_lbl.set_xalign(0)
        browser_lbl.set_margin_bottom(4)
        body.pack_start(browser_lbl, False, False, 0)

        browser_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        browser_row.set_margin_bottom(16)
        self._browser_buttons: dict[str, Gtk.Button] = {}
        for browser in self._config.browsers:
            if not browser.id:
                continue
            btn = Gtk.Button(label=browser.label)
            btn.get_style_context().add_class("radio-pick")
            btn.connect("clicked", self._on_browser_clicked, browser.id)
            browser_row.pack_start(btn, False, False, 0)
            self._browser_buttons[browser.id] = btn
        self._set_browser_active(self._config.default_browser_id)
        body.pack_start(browser_row, False, False, 0)

        # Spacer
        body.pack_start(Gtk.Box(), True, True, 0)

        # ── Footer: Apply (Cancel dropped — no modal to cancel from) ──
        foot_sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        foot_sep.set_margin_bottom(10)
        body.pack_start(foot_sep, False, False, 0)

        btn_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_row.set_halign(Gtk.Align.END)

        self._apply_btn = Gtk.Button(label="Apply")
        self._apply_btn.get_style_context().add_class("suggested-action")
        self._apply_btn.connect("clicked", self._on_apply)
        btn_row.pack_start(self._apply_btn, False, False, 0)

        body.pack_start(btn_row, False, False, 0)

    # ── internal helpers ──

    def _set_theme_active(self, active: str) -> None:
        self._selected_theme = active
        for label, btn in self._theme_buttons.items():
            ctx = btn.get_style_context()
            if label == active:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")

    def _on_theme_clicked(self, btn: Gtk.Button, label: str) -> None:
        self._set_theme_active(label)
        # Live preview: swap the welcome panel's own CSS so the user sees the
        # change without leaving the Customization page. Apply still pushes
        # through to xfconf for system-wide effect.
        self._theme_preview.apply(label)

    def _update_chip_style(self, chip: Gtk.ToggleButton) -> None:
        ctx = chip.get_style_context()
        if chip.get_active():
            ctx.add_class("active")
        else:
            ctx.remove_class("active")

    def _on_chip_toggled(self, chip: Gtk.ToggleButton, label: str) -> None:
        self._update_chip_style(chip)

    def _set_browser_active(self, active: str) -> None:
        self._selected_browser = active
        for label, btn in self._browser_buttons.items():
            ctx = btn.get_style_context()
            if label == active:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")

    def _on_browser_clicked(self, btn: Gtk.Button, label: str) -> None:
        self._set_browser_active(label)

    def _on_apply(self, _btn: Gtk.Button) -> None:
        values = {
            "theme": self._selected_theme,
            "wallpaper_rotate": self._wp_switch.get_active(),
            "dock": {
                label: chip.get_active()
                for label, chip in self._dock_chips.items()
            },
            "browser": self._selected_browser,
        }
        results = self._coordinator.apply_all(values)
        all_ok = all(r.ok for r in results)
        # Tell the surrounding WelcomeWindow that the user customised
        # explicitly — otherwise dismiss would re-apply the all-categories
        # default and stomp the user's chip choices.
        self._window.applied_during_session = True
        # Inline-page feedback: Apply confirms by updating the button label.
        # Reset on next change is out of scope here — apply is idempotent.
        self._apply_btn.set_label("Applied!" if all_ok else "Applied (with errors)")
        self._apply_btn.set_sensitive(False)
        GLib.timeout_add_seconds(2, self._reset_apply_button)

    def _reset_apply_button(self) -> bool:
        self._apply_btn.set_label("Apply")
        self._apply_btn.set_sensitive(True)
        return False  # one-shot


