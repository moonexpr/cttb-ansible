    page.pack_start(footer, False, False, 0)
    page.pack_start(Gtk.Box(), True, True, 0)
    return page


# ── CSS injection ─────────────────────────────────────────────────────────────
# Module-level state for the active provider so theme switches can swap it
# in place rather than stacking providers (each add_provider_for_screen is
# additive — without removing the prior provider, dark colours bleed through
# light and vice versa).
_ACTIVE_PROVIDER: Gtk.CssProvider | None = None


def _css_for_theme(theme: str) -> bytes:
    if theme.lower() == "light":
        return GTK_CSS_LIGHT
    # "Dark", "Auto", or anything else falls through to dark; THEME_MAP's
    # comment explains why Auto stays dark until xdg-portal switching lands.
    return GTK_CSS_DARK


def apply_css_safe(theme: str = "Dark") -> None:
    """Load (or hot-swap) the welcome panel's CSS provider for `theme`.
    Called once at startup with the persisted preference, and again live
    from the Customization page when the theme segmented control is touched."""
    global _ACTIVE_PROVIDER
    try:
        from gi.repository import Gdk  # noqa: PLC0415
        screen = Gdk.Screen.get_default()
        if screen is None:
            return

        # Drop any prior provider so the new one isn't layered on top of it.
        if _ACTIVE_PROVIDER is not None:
            Gtk.StyleContext.remove_provider_for_screen(screen, _ACTIVE_PROVIDER)
            _ACTIVE_PROVIDER = None

        provider = Gtk.CssProvider()
        provider.load_from_data(_css_for_theme(theme))
        Gtk.StyleContext.add_provider_for_screen(
            screen,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
        _ACTIVE_PROVIDER = provider
    except Exception as exc:
        log(f"CSS provider failed (continuing without theme): {exc}")


# ── Entry point ───────────────────────────────────────────────────────────────
def main() -> int:
    if "DISPLAY" not in os.environ and "WAYLAND_DISPLAY" not in os.environ:
        return 0
    log(f"start pid={os.getpid()} uid={os.getuid()} "
        f"force={bool(os.environ.get('SUDHANIX_WELCOME_FORCE'))}")

    uid = os.getuid()
    try:
        username = pwd.getpwuid(uid).pw_name
    except KeyError:
        log(f"no passwd entry for uid {uid}")
        return 0

    user_dn = LDAP_DN_TEMPLATE.format(uid=username)

    # SUDHANIX_WELCOME_FORCE bypasses the dismissal/token gate so vajra's
    # test_welcome_preview "Show window" action and any future preview path
    # can render the panel regardless of LDAP state. The Continue button still
    # writes the dismissal flag if the user accepts; the toolset can clear it.
    force = os.environ.get("SUDHANIX_WELCOME_FORCE", "").strip().lower() in ("1", "true", "yes")

    if not force:
        tok = token_path(uid)
        if tok is None:
            log("no cached PAM token; can't reach LDAP this session")
            return 0

        state = already_dismissed(user_dn, tok)
        if state is True:
            return 0
        if state is None:
            # Couldn't query LDAP — don't pester the user since we can't
            # remember their dismissal anyway.
            return 0

    # User has not yet completed welcome. Refresh ~/.config/plank/ from
    # /etc/skel BEFORE the panel paints, so Apply / dismiss-default have
    # a known canonical launchers/ to filter against. Without this, a
    # migrated user with a stale or empty .config/plank/ ends up with
    # Plank's auto-detect garbage in user-db, which dconf write can't
    # cleanly recover from.
    refresh_plank_skel()

    apply_css_safe()

    win = WelcomeWindow()
    win.show_all()
    Gtk.main()

    if win.dismiss_on_continue and not force:
        try:
            write_dismissal(user_dn, tok)
        except Exception as exc:
            log(f"write_dismissal failed: {exc}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
