class WelcomeWindow(Gtk.Window):
    """
    960x540 main panel.
    Left sidebar (240px) + right pane (Gtk.Stack on top, persistent action row
    at the bottom). Sidebar ListBox row-selection drives stack page switch.
    Visual / copy redesign tracked in #4; this layout is the wiring layer
    landed in #51.
    """

    def __init__(self) -> None:
        super().__init__(title="Welcome")
        self.set_name("welcome-window")
        self.set_default_size(960, 540)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.dismiss_on_continue = True  # checkbox default

        self.connect("destroy", Gtk.main_quit)

        # Top-level horizontal split
        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(hbox)

        # Stack must exist before sidebar is built (sidebar binds to it).
        self._stack = Gtk.Stack()
        self._stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self._stack.set_transition_duration(180)
        self._stack.add_named(self._build_welcome_page(), PAGE_WELCOME)
        self._stack.add_named(self._build_whats_new_page(), PAGE_WHATS_NEW)
        self._stack.add_named(self._build_quick_tour_page(), PAGE_QUICK_TOUR)
        self._stack.add_named(CustomizationPage(), PAGE_CUSTOMIZATION)
        self._stack.add_named(AboutPage(), PAGE_ABOUT)
        self._stack.set_visible_child_name(PAGE_WELCOME)

        hbox.pack_start(self._build_sidebar(), False, False, 0)
        hbox.pack_start(self._build_right_pane(), True, True, 0)

    def _build_sidebar(self) -> Gtk.Box:
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sidebar.set_name("sidebar")
        sidebar.set_size_request(240, -1)
        sidebar.set_border_width(0)

        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        inner.set_margin_top(26)
        inner.set_margin_bottom(18)
        inner.set_margin_start(18)
        inner.set_margin_end(18)
        sidebar.pack_start(inner, True, True, 0)

        # Brand lockup
        brand = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        brand.set_margin_bottom(18)

        lotus = lotus_image(40)
        if lotus:
            brand.pack_start(lotus, False, False, 0)

        brand_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        wordmark = Gtk.Label()
        wordmark.set_markup(
            "<span weight='600' size='15000'>"
            "Sudha<span color='#D99A3C'>*</span>nix"
            "</span>"
        )
        wordmark.set_xalign(0)
        brand_col.pack_start(wordmark, False, False, 0)

        ver = Gtk.Label(label="version 26")
        ver.get_style_context().add_class("dim-label")
        ver.set_xalign(0)
        brand_col.pack_start(ver, False, False, 0)

        brand.pack_start(brand_col, True, True, 0)
        inner.pack_start(brand, False, False, 0)

        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        sep.set_margin_bottom(14)
        inner.pack_start(sep, False, False, 0)

        # "Get started" section label
        nav_heading = Gtk.Label(label="GET STARTED")
        nav_heading.get_style_context().add_class("dim-label")
        nav_heading.set_xalign(0)
        nav_heading.set_margin_bottom(6)
        inner.pack_start(nav_heading, False, False, 0)

        # Nav list — every row routes to a Gtk.Stack page (#51).
        nav_list = Gtk.ListBox()
        nav_list.get_style_context().add_class("navigation-sidebar")
        nav_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        nav_list.set_activate_on_single_click(True)

        first_row: Gtk.ListBoxRow | None = None
