        page_name = getattr(row, "page_name", None)
        if page_name:
            self._stack.set_visible_child_name(page_name)

    def _on_continue(self, _btn: Gtk.Button) -> None:
        self.dismiss_on_continue = self._skip_checkbox.get_active()
        if not self.applied_during_session:
            self._apply_default_layout()
        Gtk.main_quit()

    def _on_destroy(self, _w: Gtk.Window) -> None:
        if not self.applied_during_session:
            self._apply_default_layout()
        Gtk.main_quit()

    def _apply_default_layout(self) -> None:
        """Dismiss without Apply -> populate dock with every category and
        the default theme/browser. Without this the dock would stay empty
        and auto-hidden because the site default starts it that way."""
        try:
            dock_choices = {
                key: True for key, cat in self._dock_categories.items()
                if not cat.always_on
            }
            self._coordinator.apply_all({
                "theme": self._config.default_theme_id,
                "wallpaper_rotate": True,
                "dock": dock_choices,
                "browser": self._config.default_browser_id,
            })
        except Exception as exc:
            log(f"default-layout apply failed: {exc}")


def _build_card_page(
    *,
    heading: str,
    cards: list[tuple[str, str, str]],
    footer_text: str,
    footer_label: str,
    footer_url: str,
) -> Gtk.Box:
    """2x2 grid of takeaway cards (icon + title + 1-sentence body) + footer
    pointing at the canonical wiki article. Used for both What's new and
    Quick tour. Card content is provisional; tune later (#4)."""
    page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    page.set_margin_top(28)
    page.set_margin_start(36)
    page.set_margin_end(36)

    title = Gtk.Label()
    title.set_markup(
        f"<span weight='600' size='22000'>"
        f"{GLib.markup_escape_text(heading)}</span>"
    )
    title.set_xalign(0)
    title.set_margin_bottom(18)
    page.pack_start(title, False, False, 0)

    grid = Gtk.Grid()
    grid.set_row_spacing(14)
    grid.set_column_spacing(20)
    grid.set_column_homogeneous(True)

    for idx, (icon_name, card_title, card_body) in enumerate(cards):
        col = idx % 2
        row = idx // 2

        card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

        icon = welcome_icon(icon_name, 44)
        if icon is not None:
            icon.set_valign(Gtk.Align.START)
            card.pack_start(icon, False, False, 0)

        text_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        t = Gtk.Label()
        t.set_markup(
            f"<span weight='600' size='11500'>"
            f"{GLib.markup_escape_text(card_title)}</span>"
        )
        t.set_xalign(0)
        t.set_line_wrap(True)
        t.set_max_width_chars(28)
        text_col.pack_start(t, False, False, 0)

        b = Gtk.Label(label=card_body)
        b.get_style_context().add_class("dim-label")
        b.set_xalign(0)
        b.set_yalign(0)
        b.set_line_wrap(True)
        b.set_max_width_chars(34)
        text_col.pack_start(b, False, False, 0)

        card.pack_start(text_col, True, True, 0)
        grid.attach(card, col, row, 1, 1)

    page.pack_start(grid, False, False, 0)

    # Footer: wiki link.
    footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    footer.set_margin_top(18)

    pre = Gtk.Label(label=footer_text)
    pre.get_style_context().add_class("dim-label")
    pre.set_xalign(0)
    footer.pack_start(pre, False, False, 0)

    link = Gtk.Label()
    link.set_markup(
        f'<a href="{GLib.markup_escape_text(footer_url)}">'
        f'{GLib.markup_escape_text(footer_label)}</a>'
    )
    link.set_xalign(0)
    footer.pack_start(link, False, False, 0)

    page.pack_start(footer, False, False, 0)
    page.pack_start(Gtk.Box(), True, True, 0)
    return page


# ─── ThemePreview ──────────────────────────────────────────────────────────
# Owns the live CSS provider for the welcome panel. apply() hot-swaps it:
# additive add_provider_for_screen calls would let dark colours bleed through
# a light overlay (and vice versa), so we always remove the prior provider
# before installing the new one. One instance per WelcomeApplication.


class ThemePreview:
    def __init__(self) -> None:
        self._provider: Gtk.CssProvider | None = None

    def apply(self, theme_id: str) -> None:
        try:
            from gi.repository import Gdk  # noqa: PLC0415
            screen = Gdk.Screen.get_default()
            if screen is None:
                return
            if self._provider is not None:
                Gtk.StyleContext.remove_provider_for_screen(screen, self._provider)
                self._provider = None
            provider = Gtk.CssProvider()
            provider.load_from_data(self._css_for_theme(theme_id))
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )
            self._provider = provider
        except Exception as exc:
            log(f"CSS provider failed (continuing without theme): {exc}")

    def clear(self) -> None:
        try:
            from gi.repository import Gdk  # noqa: PLC0415
            screen = Gdk.Screen.get_default()
            if screen is not None and self._provider is not None:
                Gtk.StyleContext.remove_provider_for_screen(screen, self._provider)
        except Exception:
            pass
        self._provider = None

    @staticmethod
    def _css_for_theme(theme_id: str) -> bytes:
        if theme_id.lower() == "light":
            return GTK_CSS_LIGHT
        # "Dark", "Auto", or anything else falls through to dark; Auto stays
        # dark until xdg-portal switching lands.
        return GTK_CSS_DARK


# ─── WelcomeApplication ────────────────────────────────────────────────────
# Top-level lifecycle template: gate -> bootstrap -> show -> wait -> dismiss.
# Owns no GTK state itself; constructs the WelcomeWindow with everything it
# needs and tears it down. Errors in the dismissal write-back are swallowed
# so a transient LDAP failure doesn't surface as a non-zero exit.


class WelcomeApplication:
    def __init__(
        self,
        *,
        runner: CommandRunner,
        registry: DconfRegistry,
        dock: PlankDock,
        config: CustomizeConfig,
        gate: WelcomeGate,
        theme_preview: ThemePreview,
    ) -> None:
        self._runner = runner
        self._registry = registry
        self._dock = dock
        self._config = config
        self._gate = gate
        self._theme_preview = theme_preview

    def _bootstrap(self) -> None:
        # Refresh ~/.config/plank/ from /etc/skel BEFORE the panel paints,
        # so Apply / dismiss-default have a known canonical launchers/ to
        # filter against. Kept because a user upgraded from sx25 may have
        # stale launchers/ that Apply alone won't clean up — without this
        # the first dock paint shows Plank's auto-detect garbage.
        self._dock.refresh_from_skel()
        # Bootstrap CSS for the panel itself; CustomizationPage overrides
        # live when the user touches the theme segmented control.
        self._theme_preview.apply(self._config.default_theme_id)

    def run(self) -> int:
        log(f"start pid={os.getpid()} uid={os.getuid()} force={self._gate.force}")
        if not self._gate.should_show():
            return 0

        self._bootstrap()
        coordinator = SettingsCoordinator([
            ThemeApplier(self._runner, self._config),
            WallpaperApplier(self._runner),
            PlankDockApplier(self._registry, self._dock, self._config),
            BrowserTerminalApplier(self._runner, self._config),
        ])
        win = WelcomeWindow(
            coordinator=coordinator,
            config=self._config,
            registry=self._registry,
            dock=self._dock,
            theme_preview=self._theme_preview,
        )
        win.show_all()
        Gtk.main()

        if win.dismiss_on_continue and not self._gate.force:
            self._gate.mark_dismissed()
        return 0


# ── Entry point ───────────────────────────────────────────────────────────────
def _has_display() -> bool:
    return "DISPLAY" in os.environ or "WAYLAND_DISPLAY" in os.environ


def _force_mode() -> bool:
    return os.environ.get("SUDHANIX_WELCOME_FORCE", "").strip().lower() in ("1", "true", "yes")


def main() -> int:
    if not _has_display():
        return 0
    runner = CommandRunner()
    config = CustomizeConfig.load()
    registry = DconfRegistry(runner)
    dock = PlankDock(runner)
    gate = WelcomeGate(runner, force=_force_mode())
    preview = ThemePreview()
    app = WelcomeApplication(runner=runner, registry=registry, dock=dock,
                             config=config, gate=gate, theme_preview=preview)
    return app.run()


if __name__ == "__main__":
    sys.exit(main())
