# ── Logging ──────────────────────────────────────────────────────────────────
# Per-user debug log captures everything the panel does at runtime. Useful
# when the welcome runs via xdg-autostart (stderr goes to .xsession-errors
# which is hard to scrape) or when an apply path silently fails. File
# survives across sessions and rotates only when the user clears it.
_DEBUG_LOG_PATH = Path.home() / ".cache" / "sudhanix-welcome.log"


def log(msg: str) -> None:
    line = f"[sudhanix-welcome] {msg}"
    print(line, file=sys.stderr)
    # Also append to the debug log; fail-soft so logging never blocks the panel.
    try:
        _DEBUG_LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with _DEBUG_LOG_PATH.open("a") as fh:
            fh.write(f"[{__import__('datetime').datetime.now().isoformat(timespec='seconds')}] {msg}\n")
    except Exception:
        pass


# ── LDAP helpers (unchanged from v1) ────────────────────────────────────────
def token_path(uid: int) -> Path | None:
    p = Path(f"/run/sudhanix-tokens/{uid}.tok")
    try:
        st = p.stat()
    except FileNotFoundError:
        return None
    if st.st_uid != uid:
        log(f"refusing token: owner uid {st.st_uid} != session uid {uid}")
        return None
    if st.st_mode & 0o077:
        log(f"refusing token: mode {st.st_mode:o} too permissive")
        return None
    return p


def already_dismissed(user_dn: str, tok: Path) -> bool | None:
    """Returns True/False/None (None = couldn't query)."""
    cmd = [
        "ldapsearch", "-x", "-ZZ", "-H", LDAP_URI, "-LLL",
        "-D", user_dn, "-y", str(tok),
        "-b", user_dn, "-s", "base",
        "(objectClass=*)", WELCOME_FLAG_ATTR,
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        log(f"ldapsearch failed: {exc}")
        return None
    if proc.returncode != 0:
        log(f"ldapsearch rc={proc.returncode}: {proc.stderr.strip()}")
        return None
    for line in proc.stdout.splitlines():
        if line.lower().startswith(f"{WELCOME_FLAG_ATTR.lower()}:"):
            _, _, value = line.partition(":")
            return value.strip().upper() == "TRUE"
    return False


def write_dismissal(user_dn: str, tok: Path) -> None:
    proc = subprocess.run(
        ["ldapsearch", "-x", "-ZZ", "-H", LDAP_URI, "-LLL",
         "-D", user_dn, "-y", str(tok),
         "-b", user_dn, "-s", "base", "(objectClass=*)", "objectClass"],
        capture_output=True, text=True, timeout=10,
    )
    needs_oc = SUDHANIX_USER_OC.lower() not in proc.stdout.lower()

    parts = [f"dn: {user_dn}", "changetype: modify"]
    if needs_oc:
        parts += ["add: objectClass", f"objectClass: {SUDHANIX_USER_OC}", "-"]
    parts += [f"replace: {WELCOME_FLAG_ATTR}", f"{WELCOME_FLAG_ATTR}: TRUE"]
    ldif = "\n".join(parts) + "\n"

    with tempfile.NamedTemporaryFile("w", delete=False, suffix=".ldif") as fh:
        fh.write(ldif)
        ldif_path = fh.name
    try:
        os.chmod(ldif_path, 0o600)
        proc = subprocess.run(
            ["ldapmodify", "-x", "-ZZ", "-H", LDAP_URI,
             "-D", user_dn, "-y", str(tok), "-f", ldif_path],
            capture_output=True, text=True, timeout=10,
        )
        if proc.returncode != 0:
            log(f"ldapmodify rc={proc.returncode}: {proc.stderr.strip()}")
    finally:
        try:
            os.unlink(ldif_path)
        except FileNotFoundError:
            pass


# ── Settings applicator ───────────────────────────────────────────────────────
def apply_settings(values: dict) -> None:
    """
    Apply user preferences collected from the Customization dialog.
    Each setting is applied independently; a failure in one does not abort
    the rest. All errors are logged to stderr only.
    """
    log(f"apply theme={values.get('theme')!r} browser={values.get('browser')!r} "
        f"dock={values.get('dock')!r}")
    # 1. Theme — set GTK widget theme, icon theme, and xfwm4 window decorations
    # together so the user sees a single consistent Light/Dark switch.
    theme = values.get("theme", default_theme_id())
    gtk_theme, icon_theme, xfwm_theme = theme_triple(theme)
    for cmd in [
        ["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName",     "-s", gtk_theme],
        ["xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName", "-s", icon_theme],
        ["xfconf-query", "-c", "xfwm4",     "-p", "/general/theme",     "-s", xfwm_theme],
    ]:
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
            if r.returncode != 0:
                log(f"xfconf theme set failed: {r.stderr.strip()}")
        except Exception as exc:
            log(f"xfconf theme exception: {exc}")

    # 2. Wallpaper rotation
    # Enumerate xfce4-desktop monitor paths via xfconf-query, then write
    # random-order. Falls through to a comment if enumeration fails.
    rotate = values.get("wallpaper_rotate", True)
    try:
        lv = subprocess.run(
            ["xfconf-query", "-c", "xfce4-desktop", "-lv"],
            capture_output=True, text=True, timeout=5,
        )
        monitor_paths = set()
        for line in lv.stdout.splitlines():
            # e.g. /backdrop/screen0/monitorVGA-1/workspace0/image-style
            parts = line.strip().split()
            if not parts:
                continue
            prop = parts[0]
            # grab parent up to workspaceN
            segs = prop.split("/")
            if len(segs) >= 5 and segs[1] == "backdrop":
                parent = "/".join(segs[:5])
                monitor_paths.add(parent)
        if not monitor_paths:
            log("wallpaper rotation: no monitor paths found in xfconf")
        for parent in monitor_paths:
            rotate_prop = f"{parent}/random-order"
            val = "true" if rotate else "false"
            r = subprocess.run(
                ["xfconf-query", "-c", "xfce4-desktop", "-p", rotate_prop,
                 "--create", "-t", "bool", "-s", val],
                capture_output=True, text=True, timeout=5,
            )
            if r.returncode != 0:
                log(f"wallpaper rotation set failed ({rotate_prop}): {r.stderr.strip()}")
    except Exception as exc:
        log(f"wallpaper rotation exception: {exc}")

    # 3. Dock categories — rewrite plank dock-items in the user's dconf
    # user-db from the chip state. Always-on categories (essentials) are
    # included regardless; other categories follow the user's chip choices.
    # The result is wrapped with the dock_anchors framing icons (app finder
    # left, trash right). Items not present in ~/.config/plank/dock1/launchers/
    # are filtered out so missing .dockitem files don't show up as broken
    # slots in Plank. If every category resolves to zero items (or the user
    # disabled all toggleable categories AND essentials yields nothing on
    # this host), we ship a blank dock — no anchors, by design. dconf load
    # is idempotent and Plank watches dconf, so the dock updates without
    # a restart.
    dock = values.get("dock", {})  # {"office": True, "code": False, ...}
    try:
        cats = load_dock_categories()
        present_items: set[str] = set()
        if PLANK_LAUNCHERS_DIR.exists():
            present_items = {p.name for p in PLANK_LAUNCHERS_DIR.glob("*.dockitem")}

        # Build (weight, items[]) groups. Each enabled category contributes
        # one group; each anchor entry contributes a single-item group.
        # Anchors only join the sort when at least one category contributes
        # items — toggling everything off yields a blank dock by design.
        category_groups: list[tuple[int, list[str]]] = []
        for key, cat in cats.items():
            if cat.get("always_on"):
                enabled = True
            else:
                enabled = bool(dock.get(key, cat.get("default_enabled", False)))
            if not enabled:
                continue
            cat_w = int(cat.get("weight", cat.get("order", 999)))
            cat_items = [
                i for i in cat.get("items", []) if i in present_items
            ]
            if cat_items:
                category_groups.append((cat_w, cat_items))

        target: list[str] = []
        if category_groups:
            anchor_groups: list[tuple[int, list[str]]] = []
            for a in dock_anchors():
                item = a.get("item", "")
                if item and item in present_items:
                    anchor_groups.append((int(a.get("weight", 0)), [item]))
            for _w, group_items in sorted(
                category_groups + anchor_groups, key=lambda g: g[0]
            ):
                for item in group_items:
                    if item not in target:
                        target.append(item)

        # Always write — including the empty list — so that toggling every
        # category off actually produces the blank dock the user asked for,
        # rather than leaving the prior dock-items in place. Also flip
        # hide-mode back to 'none' so the dock becomes visible: the
        # site-default starts it auto-hidden until the user has either
        # chosen or accepted the default through the welcome flow.
        # An empty array needs the @as GVariant type annotation so dconf
        # can infer the element type.
        if target:
            quoted = ", ".join(f"'{i}'" for i in target)
            items_value = f"[{quoted}]"
        else:
            items_value = "@as []"
        seed = (
            "[docks/dock1]\n"
            f"dock-items={items_value}\n"
            "hide-mode='none'\n"
        ).encode()
        r = subprocess.run(
            ["dconf", "load", "/net/launchpad/plank/"],
            input=seed, capture_output=True, timeout=5,
        )
        if r.returncode != 0:
            log("dconf dock load failed: "
                + r.stderr.decode(errors="replace").strip())
        else:
            log(f"dock-items rewritten: {len(target)} items")

        # Persist the user's category choices into their dconf so vajra and
        # future tools can read them back without re-deriving.
        choices_lines = []
        for key, enabled in dock.items():
            choices_lines.append(f"{key}={'true' if enabled else 'false'}")
        if choices_lines:
            choices_seed = ("[enabled]\n" + "\n".join(choices_lines) + "\n").encode()
            subprocess.run(
                ["dconf", "load", "/org/sudhanix/dock/"],
                input=choices_seed, capture_output=True, timeout=5,
            )
    except Exception as exc:
        log(f"dock dconf exception: {exc}")

    # Also keep the JSON marker for sysadmin inspection / future ansible
    # runs that want to reproduce a user's choices.
    try:
        SUDHANIX_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        DOCK_PREFS_FILE.write_text(json.dumps(dock, indent=2))
    except Exception as exc:
        log(f"dock prefs write failed: {exc}")

    # 4. Default browser
    browser = values.get("browser", default_browser_id())
    desktop_file = browser_desktop(browser) or browser_desktop(default_browser_id())
    try:
        r = subprocess.run(
            ["xdg-settings", "set", "default-web-browser", desktop_file],
            capture_output=True, text=True, timeout=5,
        )
        if r.returncode != 0:
            log(f"xdg-settings browser set failed: {r.stderr.strip()}")
    except Exception as exc:
        log(f"xdg-settings exception: {exc}")


# ── Pixbuf helpers ────────────────────────────────────────────────────────────
def lotus_image(size: int) -> Gtk.Image | None:
    """Return a Gtk.Image at the requested square pixel size, or None on error."""
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(
            LOTUS_PATH, size, size, True
        )
        img = Gtk.Image.new_from_pixbuf(pb)
        return img
    except Exception as exc:
        log(f"lotus asset missing or unreadable ({LOTUS_PATH}): {exc}")
        return None


def welcome_icon(name: str, size: int = 44) -> Gtk.Image | None:
    """Load a theme-neutral SVG line-art icon from WELCOME_ICONS_DIR."""
    path = f"{WELCOME_ICONS_DIR}/{name}.svg"
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        return Gtk.Image.new_from_pixbuf(pb)
    except Exception as exc:
        log(f"welcome icon missing ({path}): {exc}")
        return None


