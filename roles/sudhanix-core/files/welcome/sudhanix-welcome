# ── Logging ──────────────────────────────────────────────────────────────────
# Per-user debug log captures everything the panel does at runtime. Useful
# when the welcome runs via xdg-autostart (stderr goes to .xsession-errors
# which is hard to scrape) or when an apply path silently fails. File
# survives across sessions and rotates only when the user clears it.
_DEBUG_LOG_PATH = Path.home() / ".cache" / "sudhanix-welcome.log"


def log(msg: str) -> None:
    line = f"[sudhanix-welcome] {msg}"
    print(line, file=sys.stderr)
    # Also append to the debug log; fail-soft so logging never blocks the panel.
    try:
        _DEBUG_LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        with _DEBUG_LOG_PATH.open("a") as fh:
            fh.write(f"[{__import__('datetime').datetime.now().isoformat(timespec='seconds')}] {msg}\n")
    except Exception:
        pass


# ─── WelcomeGate ───────────────────────────────────────────────────────────
# Encapsulates the DISPLAY-agnostic part of the first-login gate: PAM token,
# LDAP-stored dismissal flag, and the dismissal write-back. Fail-soft: any
# unreachable LDAP / missing token returns "don't show" so the panel never
# pesters a user whose dismissal we can't remember anyway.


class WelcomeGate:
    def __init__(self, runner: CommandRunner, *, force: bool = False) -> None:
        self._runner = runner
        self._force = force
        self._uid_value = os.getuid()
        self._username: str | None = None
        try:
            self._username = pwd.getpwuid(self._uid_value).pw_name
        except KeyError:
            log(f"no passwd entry for uid {self._uid_value}")
        self._user_dn = (LDAP_DN_TEMPLATE.format(uid=self._username)
                         if self._username else "")
        self._token: Path | None = None

    @property
    def force(self) -> bool:
        return self._force

    def should_show(self) -> bool:
        if self._force:
            return True
        if self._username is None:
            return False
        self._token = self._token_path(self._uid_value)
        if self._token is None:
            log("no cached PAM token; can't reach LDAP this session")
            return False
        state = self._query_ldap(self._user_dn, self._token)
        if state is True:
            return False
        if state is None:
            # Couldn't query LDAP — don't pester the user since we can't
            # remember their dismissal anyway.
            return False
        return True

    def mark_dismissed(self) -> None:
        if self._username is None or self._token is None:
            return
        try:
            self._write_ldap(self._user_dn, self._token)
        except Exception as exc:
            log(f"write_dismissal failed: {exc}")

    @staticmethod
    def _token_path(uid: int) -> Path | None:
        p = Path(f"/run/sudhanix-tokens/{uid}.tok")
        try:
            st = p.stat()
        except FileNotFoundError:
            return None
        if st.st_uid != uid:
            log(f"refusing token: owner uid {st.st_uid} != session uid {uid}")
            return None
        if st.st_mode & 0o077:
            log(f"refusing token: mode {st.st_mode:o} too permissive")
            return None
        return p

    def _query_ldap(self, user_dn: str, tok: Path) -> bool | None:
        r = self._runner.run_text(
            ["ldapsearch", "-x", "-ZZ", "-H", LDAP_URI, "-LLL",
             "-D", user_dn, "-y", str(tok),
             "-b", user_dn, "-s", "base",
             "(objectClass=*)", WELCOME_FLAG_ATTR],
            timeout=10,
        )
        if not r.ok:
            return None
        for line in r.stdout.splitlines():
            if line.lower().startswith(f"{WELCOME_FLAG_ATTR.lower()}:"):
                _, _, value = line.partition(":")
                return value.strip().upper() == "TRUE"
        return False

    def _write_ldap(self, user_dn: str, tok: Path) -> None:
        probe = self._runner.run_text(
            ["ldapsearch", "-x", "-ZZ", "-H", LDAP_URI, "-LLL",
             "-D", user_dn, "-y", str(tok),
             "-b", user_dn, "-s", "base", "(objectClass=*)", "objectClass"],
            timeout=10,
        )
        needs_oc = SUDHANIX_USER_OC.lower() not in probe.stdout.lower()

        parts = [f"dn: {user_dn}", "changetype: modify"]
        if needs_oc:
            parts += ["add: objectClass", f"objectClass: {SUDHANIX_USER_OC}", "-"]
        parts += [f"replace: {WELCOME_FLAG_ATTR}", f"{WELCOME_FLAG_ATTR}: TRUE"]
        ldif = "\n".join(parts) + "\n"

        with tempfile.NamedTemporaryFile("w", delete=False, suffix=".ldif") as fh:
            fh.write(ldif)
            ldif_path = fh.name
        try:
            os.chmod(ldif_path, 0o600)
            self._runner.run_text(
                ["ldapmodify", "-x", "-ZZ", "-H", LDAP_URI,
                 "-D", user_dn, "-y", str(tok), "-f", ldif_path],
                timeout=10,
            )
        finally:
            try:
                os.unlink(ldif_path)
            except FileNotFoundError:
                pass


# ── Pixbuf helpers ────────────────────────────────────────────────────────────
def lotus_image(size: int) -> Gtk.Image | None:
    """Return a Gtk.Image at the requested square pixel size, or None on error."""
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(
            LOTUS_PATH, size, size, True
        )
        img = Gtk.Image.new_from_pixbuf(pb)
        return img
    except Exception as exc:
        log(f"lotus asset missing or unreadable ({LOTUS_PATH}): {exc}")
        return None


def welcome_icon(name: str, size: int = 44) -> Gtk.Image | None:
    """Load a theme-neutral SVG line-art icon from WELCOME_ICONS_DIR."""
    path = f"{WELCOME_ICONS_DIR}/{name}.svg"
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        return Gtk.Image.new_from_pixbuf(pb)
    except Exception as exc:
        log(f"welcome icon missing ({path}): {exc}")
        return None


