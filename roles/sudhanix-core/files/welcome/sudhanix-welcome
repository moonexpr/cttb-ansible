        theme_sublbl.set_xalign(0)
        theme_sublbl.set_line_wrap(True)
        theme_sublbl.set_max_width_chars(30)
        theme_lbl_col.pack_start(theme_sublbl, False, False, 0)
        theme_row.pack_start(theme_lbl_col, True, True, 0)

        seg_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        seg_box.set_name("theme-seg")
        self._theme_buttons: dict[str, Gtk.Button] = {}
        for theme in self._config.themes:
            if not theme.id:
                continue
            btn = Gtk.Button(label=theme.label)
            btn.set_relief(Gtk.ReliefStyle.NONE)
            btn.connect("clicked", self._on_theme_clicked, theme.id)
            seg_box.pack_start(btn, False, False, 0)
            self._theme_buttons[theme.id] = btn
        self._set_theme_active(self._config.default_theme_id)
        theme_row.pack_start(seg_box, False, False, 0)
        body.pack_start(theme_row, False, False, 0)

        # Wallpaper rotation switch
