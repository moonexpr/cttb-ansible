        # ── Appearance section ──
        app_label = Gtk.Label(label="APPEARANCE")
        app_label.get_style_context().add_class("dim-label")
        app_label.set_xalign(0)
        app_label.set_margin_bottom(6)
        body.pack_start(app_label, False, False, 0)

        # Theme segmented control
        theme_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        theme_row.set_margin_bottom(10)

        theme_lbl_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
