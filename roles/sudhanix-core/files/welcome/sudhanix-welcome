        wp_lbl_col.pack_start(wp_lbl, False, False, 0)
        wp_sublbl = Gtk.Label(label="Cycle through the campus wallpaper set each morning.")
        wp_sublbl.get_style_context().add_class("dim-label")
        wp_sublbl.set_xalign(0)
        wp_sublbl.set_line_wrap(True)
        wp_sublbl.set_max_width_chars(30)
        wp_lbl_col.pack_start(wp_sublbl, False, False, 0)
        wp_row.pack_start(wp_lbl_col, True, True, 0)

        self._wp_switch = Gtk.Switch()
        self._wp_switch.set_active(True)
        self._wp_switch.set_valign(Gtk.Align.CENTER)
        wp_row.pack_start(self._wp_switch, False, False, 0)
        body.pack_start(wp_row, False, False, 0)

        sep1 = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        sep1.set_margin_bottom(12)
        body.pack_start(sep1, False, False, 0)

        # ── Dock section ──
        dock_label = Gtk.Label(label="DOCK -- APP CATEGORIES")
        dock_label.get_style_context().add_class("dim-label")
        dock_label.set_xalign(0)
        dock_label.set_margin_bottom(6)
        body.pack_start(dock_label, False, False, 0)

        # Categories + prior enabled state were resolved by WelcomeWindow
        # (registry → YAML fallback for the category set, registry per-key
        # for prior user choices). UI is render-only from here.
        chip_flow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        chip_flow.set_margin_bottom(10)
        self._dock_chips: dict[str, Gtk.ToggleButton] = {}
        always_on_labels: list[str] = []
        ordered_keys = sorted(
            self._dock_categories.keys(),
            key=lambda k: (self._dock_categories[k].weight, k),
        )
        for key in ordered_keys:
            cat = self._dock_categories[key]
            if cat.always_on:
                always_on_labels.append(cat.label)
                continue
            default_on = prior_choices.get(key, cat.default_enabled)
            chip = Gtk.ToggleButton(label=cat.label)
            chip.get_style_context().add_class("chip")
            chip.set_active(default_on)
            chip.connect("toggled", self._on_chip_toggled, key)
            self._update_chip_style(chip)
            chip_flow.pack_start(chip, False, False, 0)
            self._dock_chips[key] = chip
        body.pack_start(chip_flow, False, False, 0)

        if always_on_labels:
            note = Gtk.Label(
                label="Always pinned: " + ", ".join(always_on_labels)
            )
            note.get_style_context().add_class("dim-label")
            note.set_xalign(0)
            note.set_margin_bottom(8)
            body.pack_start(note, False, False, 0)

        # Default browser
