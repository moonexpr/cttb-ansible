def _load_customize() -> dict:
    """Read customize.yml. Return {} on any failure so callers fall back to
    embedded defaults — this script must never refuse to launch over a
    config-file glitch."""
    if not _HAVE_YAML:
        return {}
    try:
        with open(CUSTOMIZE_PATH, encoding="utf-8") as fh:
            data = yaml.safe_load(fh)
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except Exception as exc:
        log(f"customize.yml unreadable ({CUSTOMIZE_PATH}): {exc}")
        return {}


# Module-level state populated at first call. log() is defined later in the
# file, so we defer the actual read until the first lookup.
_CUSTOMIZE: dict | None = None


def _customize() -> dict:
    global _CUSTOMIZE
    if _CUSTOMIZE is None:
        _CUSTOMIZE = _load_customize()
    return _CUSTOMIZE


def themes() -> list[dict]:
    """List of theme presets from customize.yml or the embedded fallback."""
    rows = _customize().get("themes")
    if isinstance(rows, list) and rows:
        return rows
    return _FALLBACK_THEMES


def default_theme_id() -> str:
    return _customize().get("default_theme") or _FALLBACK_DEFAULT_THEME


def browsers() -> list[dict]:
    rows = _customize().get("browsers")
