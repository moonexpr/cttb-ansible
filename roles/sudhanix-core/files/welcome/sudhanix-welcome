# ─── PlankDock ─────────────────────────────────────────────────────────────
# Facade over the per-user plank launchers dir + the clear → seed → replace
# lifecycle. replace_items(items) is the single entry point Apply uses; the
# refresh_from_skel() helper preserves the session-start behaviour where a
# migrated user with stale ~/.config/plank/ gets re-aligned with /etc/skel
# before the panel paints.


class PlankDock:
    def __init__(
        self,
        runner: CommandRunner,
        *,
        skel_dir: Path = PLANK_SKEL_DIR,
        user_dir: Path | None = None,
    ) -> None:
        self._runner = runner
        self._skel_dir = skel_dir
        self._user_dir = user_dir if user_dir is not None else PLANK_USER_DIR
        self._launchers_dir = self._user_dir / "dock1" / "launchers"
        self._skel_launchers_dir = self._skel_dir / "dock1" / "launchers"

    @property
    def launchers_dir(self) -> Path:
        return self._launchers_dir

    @property
    def skel_launchers_dir(self) -> Path:
        return self._skel_launchers_dir

    @property
    def skel_items(self) -> set[str]:
        if not self._skel_launchers_dir.is_dir():
            return set()
        return {p.name for p in self._skel_launchers_dir.glob("*.dockitem")}

    @property
    def user_items(self) -> set[str]:
        if not self._launchers_dir.is_dir():
            return set()
        return {p.name for p in self._launchers_dir.glob("*.dockitem")}

    def ensure_user_dir(self) -> None:
        self._user_dir.mkdir(parents=True, exist_ok=True)
        self._launchers_dir.mkdir(parents=True, exist_ok=True)

    def _clear(self) -> list[str]:
        if not self._launchers_dir.is_dir():
            log(f"PlankDock._clear: launchers dir absent ({self._launchers_dir}); nothing to do")
            return []
        removed: list[str] = []
        for existing in self._launchers_dir.glob("*.dockitem"):
            try:
                existing.unlink()
                removed.append(existing.name)
            except Exception as exc:
                log(f"PlankDock._clear: unlink {existing.name} failed: {exc}")
        log(f"PlankDock._clear: removed={len(removed)} ({removed!r})")
        return removed

    def _seed(self, items: list[str]) -> list[str]:
        if not self._skel_launchers_dir.is_dir():
            log(f"PlankDock._seed: skel launchers missing ({self._skel_launchers_dir}); skip")
            return []
        self.ensure_user_dir()
        seeded: list[str] = []
        for name in items:
            src = self._skel_launchers_dir / name
            if not src.is_file():
                log(f"PlankDock._seed: skel missing {name}; skip")
                continue
            dst = self._launchers_dir / name
            try:
                dst.write_bytes(src.read_bytes())
                seeded.append(name)
            except Exception as exc:
                log(f"PlankDock._seed: copy {name} failed: {exc}")
        log(f"PlankDock._seed: seeded={len(seeded)} ({seeded!r})")
        return seeded

    def replace_items(self, items: list[str]) -> bool:
        """clear → seed → plank --replace. Returns True on full success."""
        try:
            self._clear()
            self._seed(items)
            self._runner.dispatch(["plank", "--replace"])
            return True
        except Exception as exc:
            log(f"PlankDock.replace_items: top-level error: {exc}")
            return False

    def refresh_from_skel(self) -> None:
        """Strict mirror of skel launchers/ into the user's launchers/. Seeds
        every canonical file AND prunes anything Plank's auto-detect dropped
        in. Called at session start, before Apply, so a migrated user with a
        stale ~/.config/plank/ ends up with a clean canonical set."""
        if not self._skel_dir.is_dir():
            log(f"PlankDock.refresh_from_skel: skel dir missing ({self._skel_dir}); skip")
            return
        try:
            self._user_dir.mkdir(parents=True, exist_ok=True)
            if not self._skel_launchers_dir.is_dir():
                return
            self._launchers_dir.mkdir(parents=True, exist_ok=True)
            canonical = {p.name for p in self._skel_launchers_dir.glob("*.dockitem")}

            seeded = 0
            for src in self._skel_launchers_dir.glob("*.dockitem"):
                dst = self._launchers_dir / src.name
                try:
                    dst.write_bytes(src.read_bytes())
                    seeded += 1
                except Exception as exc:
                    log(f"PlankDock.refresh_from_skel: copy {src.name} failed: {exc}")

            pruned: list[str] = []
            for existing in self._launchers_dir.glob("*.dockitem"):
                if existing.name not in canonical:
                    try:
                        existing.unlink()
                        pruned.append(existing.name)
                    except Exception as exc:
                        log(f"PlankDock.refresh_from_skel: prune {existing.name} failed: {exc}")
            log(f"PlankDock.refresh_from_skel: seeded={seeded} pruned={len(pruned)} ({pruned!r})")
        except Exception as exc:
            log(f"PlankDock.refresh_from_skel: top-level error: {exc}")


# ─── ApplyResult + SettingsApplier base ────────────────────────────────────
# Strategy interface for the four Apply subsystems (theme / wallpaper / dock /
# browser+terminal). Each applier owns its own injected deps; the coordinator
# (below) walks them in list order. Result objects are aggregated by the UI
# to drive the "Applied!" vs "Applied (with errors)" button feedback.


@dataclass(frozen=True)
class ApplyResult:
    applier: str
    ok: bool
    summary: str
    error: Exception | None = None


class SettingsApplier(abc.ABC):
    name: str = ""

    @abc.abstractmethod
    def apply(self, values: dict) -> ApplyResult:
        ...


# ─── ThemeApplier ──────────────────────────────────────────────────────────
# Sets GTK widget theme, icon theme, and xfwm window-decoration theme as a
# single Light/Dark switch. Does NOT touch the in-panel CSS preview — that's
# owned by ThemePreview, swapped live from CustomizationPage on chip click.


class ThemeApplier(SettingsApplier):
    name = "theme"

    def __init__(self, runner: CommandRunner, config: CustomizeConfig) -> None:
        self._runner = runner
        self._config = config

    def apply(self, values: dict) -> ApplyResult:
        if "theme" not in values:
            return ApplyResult(applier=self.name, ok=True,
                               summary="theme: no change requested")
        try:
            theme_id = values["theme"]
            theme = self._config.theme(theme_id) or self._config.default_theme()
            gtk_theme, icon_theme, xfwm_theme = theme.triple()
            results = [
                self._runner.run_text(
                    ["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName",
                     "-s", gtk_theme]),
                self._runner.run_text(
                    ["xfconf-query", "-c", "xsettings", "-p", "/Net/IconThemeName",
                     "-s", icon_theme]),
                self._runner.run_text(
                    ["xfconf-query", "-c", "xfwm4", "-p", "/general/theme",
                     "-s", xfwm_theme]),
            ]
            ok = all(r.ok for r in results)
            return ApplyResult(applier=self.name, ok=ok,
                               summary=f"theme set to {theme.label}")
        except Exception as exc:
            log(f"ThemeApplier: {exc}")
            return ApplyResult(applier=self.name, ok=False,
                               summary="theme failed", error=exc)


# ─── WallpaperApplier ──────────────────────────────────────────────────────
# Enumerates per-monitor backdrop paths via `xfconf-query -lv` and writes
# random-order per monitor. xfconf monitor paths look like
# /backdrop/screen0/monitorVGA-1/workspace0/image-style; we grab the first
# five segments as the parent and write random-order under it.


class WallpaperApplier(SettingsApplier):
    name = "wallpaper"

    def __init__(self, runner: CommandRunner) -> None:
        self._runner = runner

    def apply(self, values: dict) -> ApplyResult:
        if "wallpaper_rotate" not in values:
            return ApplyResult(applier=self.name, ok=True,
                               summary="wallpaper: no change requested")
        try:
            rotate = bool(values["wallpaper_rotate"])
            lv = self._runner.run_text(
                ["xfconf-query", "-c", "xfce4-desktop", "-lv"])
            monitor_paths: set[str] = set()
            if lv.ok:
                for line in lv.stdout.splitlines():
                    parts = line.strip().split()
                    if not parts:
                        continue
                    prop = parts[0]
                    segs = prop.split("/")
                    if len(segs) >= 5 and segs[1] == "backdrop":
                        monitor_paths.add("/".join(segs[:5]))
            if not monitor_paths:
                log("WallpaperApplier: no monitor paths found in xfconf")
            val = "true" if rotate else "false"
            ok_all = True
            for parent in monitor_paths:
                r = self._runner.run_text(
                    ["xfconf-query", "-c", "xfce4-desktop", "-p",
                     f"{parent}/random-order", "--create", "-t", "bool",
                     "-s", val])
                if not r.ok:
                    ok_all = False
            state = "enabled" if rotate else "disabled"
            return ApplyResult(
                applier=self.name, ok=ok_all,
                summary=f"rotation {state} on {len(monitor_paths)} monitors")
        except Exception as exc:
            log(f"WallpaperApplier: {exc}")
            return ApplyResult(applier=self.name, ok=False,
                               summary="wallpaper failed", error=exc)


# ─── PlankDockApplier ──────────────────────────────────────────────────────
# Resolves chip choices into a sorted, deduped dock-items list, writes the
# Plank dconf seed via DconfRegistry, then calls PlankDock.replace_items for
# the clear → seed → plank --replace lifecycle, and finally persists the
# user's category choices to /org/sudhanix/dock/enabled/* for read-back.
#
# Filter split (per the user's prior call): categories filter against
# dock.user_items (the user needs a baseline that already exists in their
# launchers dir); anchors filter against dock.skel_items (anchors are
# canonical framing icons that should always join when the skel ships them).


class PlankDockApplier(SettingsApplier):
    name = "dock"

    def __init__(self, registry: DconfRegistry, dock: PlankDock,
                 config: CustomizeConfig) -> None:
        self._registry = registry
        self._dock = dock
        self._config = config

    def apply(self, values: dict) -> ApplyResult:
        if "dock" not in values:
            return ApplyResult(applier=self.name, ok=True,
                               summary="dock: no change requested")
        try:
            user_dock = values["dock"] or {}
            cats = self._registry.read_dock_categories()
            if cats is None or not cats:
                cats = {k: c.as_dict() for k, c
                        in self._config.default_dock_categories.items()}
            present_items = self._dock.user_items
            skel_items = self._dock.skel_items

            category_groups: list[tuple[int, list[str]]] = []
            for key, cat in cats.items():
                if cat.get("always_on"):
                    enabled = True
                else:
                    enabled = bool(
                        user_dock.get(key, cat.get("default_enabled", False)))
                if not enabled:
                    continue
                cat_w = int(cat.get("weight", 999))
                cat_items = [i for i in cat.get("items", []) if i in present_items]
                if cat_items:
                    category_groups.append((cat_w, cat_items))

            target: list[str] = []
            if category_groups:
                anchor_groups: list[tuple[int, list[str]]] = []
                for anchor in self._config.dock_anchors:
                    if anchor.item and anchor.item in (skel_items or present_items):
                        anchor_groups.append((anchor.weight, [anchor.item]))
                for _w, group_items in sorted(
                        category_groups + anchor_groups, key=lambda g: g[0]):
                    for item in group_items:
                        if item not in target:
                            target.append(item)

            wrote_seed = self._registry.write_plank_dock_items(
                target, hide_mode="none")
            self._dock.replace_items(target)
            self._registry.write_dock_choices(user_dock)
            summary = ("dock blank" if not target
                       else f"dock has {len(target)} items")
            return ApplyResult(applier=self.name, ok=wrote_seed,
                               summary=summary)
        except Exception as exc:
            log(f"PlankDockApplier: {exc}")
            return ApplyResult(applier=self.name, ok=False,
                               summary="dock failed", error=exc)


# ─── BrowserTerminalApplier ────────────────────────────────────────────────
# Two-track default registration: xdg-settings / xdg-mime for the freedesktop
# registry, and ~/.config/xfce4/helpers.rc for XFCE's exo-helper which Thunar,
# xfce4-panel, and vajra consult directly. Terminal is hard-wired to
# xfce4-terminal for now (no chip exposed yet).


class BrowserTerminalApplier(SettingsApplier):
    name = "browser"

    _BROWSER_HELPER_MAP = {
        "google-chrome.desktop": "google-chrome",
        "firefox.desktop": "firefox",
        "firefox-esr.desktop": "firefox",
        "zen-browser.desktop": "zen-browser",
    }

    def __init__(self, runner: CommandRunner, config: CustomizeConfig) -> None:
        self._runner = runner
        self._config = config

    def apply(self, values: dict) -> ApplyResult:
        if "browser" not in values:
            return ApplyResult(applier=self.name, ok=True,
                               summary="browser: no change requested")
        try:
            browser_id = values["browser"]
            browser = (self._config.browser(browser_id)
                       or self._config.default_browser())
            desktop_file = browser.desktop
            term_desktop = "xfce4-terminal.desktop"

            r1 = self._runner.run_text(
                ["xdg-settings", "set", "default-web-browser", desktop_file])
            r2 = self._runner.run_text(
                ["xdg-mime", "default", term_desktop,
                 "x-scheme-handler/terminal"])
            helpers_ok = self._patch_helpers_rc(desktop_file)
            ok = r1.ok and r2.ok and helpers_ok
            return ApplyResult(
                applier=self.name, ok=ok,
                summary=f"browser set to {browser.label}; terminal set to xfce4-terminal")
        except Exception as exc:
            log(f"BrowserTerminalApplier: {exc}")
            return ApplyResult(applier=self.name, ok=False,
                               summary="browser failed", error=exc)

    def _patch_helpers_rc(self, desktop_file: str) -> bool:
        helpers_path = Path.home() / ".config" / "xfce4" / "helpers.rc"
        try:
            helpers_path.parent.mkdir(parents=True, exist_ok=True)
            lines: dict[str, str] = {}
            if helpers_path.exists():
                for ln in helpers_path.read_text().splitlines():
                    if "=" in ln and not ln.lstrip().startswith("#"):
                        k, v = ln.split("=", 1)
                        lines[k.strip()] = v.strip()
            lines["TerminalEmulator"] = "xfce4-terminal"
            if desktop_file in self._BROWSER_HELPER_MAP:
                lines["WebBrowser"] = self._BROWSER_HELPER_MAP[desktop_file]
            helpers_path.write_text(
                "\n".join(f"{k}={v}" for k, v in lines.items()) + "\n")
            return True
        except Exception as exc:
            log(f"helpers.rc write failed: {exc}")
            return False


# ─── SettingsCoordinator ───────────────────────────────────────────────────
# Mediator: walks the strategy list in order, isolates per-applier failures
# so one broken subsystem doesn't abort the rest. Strategies' own try/except
# already produces ApplyResult on failure; the outer catch here is defense
# in depth for unexpected escapes.


class SettingsCoordinator:
    def __init__(self, appliers: list[SettingsApplier]) -> None:
        self._appliers = appliers

    def apply_all(self, values: dict) -> list[ApplyResult]:
        results: list[ApplyResult] = []
        for applier in self._appliers:
            try:
                results.append(applier.apply(values))
            except Exception as exc:
                log(f"SettingsCoordinator: {applier.name} crashed: {exc}")
                results.append(ApplyResult(
                    applier=applier.name, ok=False,
                    summary=f"{applier.name} crashed", error=exc))
        return results


