def theme_triple(theme_id: str) -> tuple[str, str, str]:
    """Return (gtk, icon, xfwm) for the named theme, falling back to the
    Dark default if the id is unknown."""
    for t in themes():
        if t.get("id") == theme_id:
            return (t.get("gtk", ""), t.get("icon", ""), t.get("xfwm", ""))
    for t in themes():
        if t.get("id") == _FALLBACK_DEFAULT_THEME:
            return (t.get("gtk", ""), t.get("icon", ""), t.get("xfwm", ""))
    return ("WhiteSur-Dark", "WhiteSur-dark", "WhiteSur-Dark")


def browser_desktop(browser_id: str) -> str:
    for b in browsers():
        if b.get("id") == browser_id:
            return b.get("desktop", "")
    return _FALLBACK_BROWSERS[0]["desktop"]


def dock_anchors() -> list[dict]:
    """Return a list of weighted anchor entries [{item, weight}, ...].
    Anchors share the 0..1000 weight number-space with categories: lower
    weight is leftward in the dock, higher is rightward, 500 is center.
    Anchors are conditional in apply_settings — they only appear when at
    least one category contributes items."""
    raw = _customize().get("dock_anchors")
    if isinstance(raw, list) and raw:
        rows: list[dict] = []
        for entry in raw:
            if not isinstance(entry, dict):
                continue
            item = entry.get("item")
            if not isinstance(item, str) or not item:
                continue
            try:
                w = int(entry.get("weight", 0))
            except (TypeError, ValueError):
                w = 0
            rows.append({"item": item, "weight": w})
        if rows:
            return rows
    # Back-compat: older customize.yml shape used {left, right} keys.
    if isinstance(raw, dict):
        rows = []
        if raw.get("left"):
            rows.append({"item": raw["left"], "weight": 0})
        if raw.get("right"):
            rows.append({"item": raw["right"], "weight": 1000})
        if rows:
            return rows
    return [dict(a) for a in _FALLBACK_DOCK_ANCHORS]

