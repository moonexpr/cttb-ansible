    """2x2 grid of takeaway cards (icon + title + 1-sentence body) + footer
    pointing at the canonical wiki article. Used for both What's new and
    Quick tour. Card content is provisional; tune later (#4)."""
    page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
