# Where Plank reads launchers from for the per-user dock1 layout.
PLANK_LAUNCHERS_DIR = Path.home() / ".config" / "plank" / "dock1" / "launchers"
PLANK_USER_DIR = Path.home() / ".config" / "plank"
PLANK_SKEL_DIR = Path("/etc/skel/.config/plank")


def refresh_plank_skel() -> None:
    """Make ~/.config/plank/dock1/launchers/ a strict mirror of
    /etc/skel/.config/plank/dock1/launchers/: seed canonical files AND
    prune anything Plank's auto-detect has dropped in.

    Called once at panel startup for users who haven't yet dismissed
    the welcome flow. The user's dock-items dconf entry is left alone
    here — apply_settings will rewrite it once we know what categories
    the user wants. The aggressive prune is the only reliable way out
    of Plank's auto-detect-clobber spiral: if launchers/ has stale
    files like app.zen_browser.zen-1.dockitem or vlc.dockitem that
    weren't seeded by us, every Plank restart can re-auto-detect them
    into dock-items, even after a clean Apply."""
    if not PLANK_SKEL_DIR.is_dir():
        log(f"refresh_plank_skel: skel dir missing ({PLANK_SKEL_DIR}); skip")
        return
    try:
        PLANK_USER_DIR.mkdir(parents=True, exist_ok=True)
        skel_launchers = PLANK_SKEL_DIR / "dock1" / "launchers"
        if not skel_launchers.is_dir():
            return

        target = PLANK_USER_DIR / "dock1" / "launchers"
        target.mkdir(parents=True, exist_ok=True)

        canonical = {p.name for p in skel_launchers.glob("*.dockitem")}

        seeded = 0
        for src in skel_launchers.glob("*.dockitem"):
            dst = target / src.name
            try:
                dst.write_bytes(src.read_bytes())
                seeded += 1
            except Exception as exc:
                log(f"refresh_plank_skel: copy {src.name} failed: {exc}")

        pruned: list[str] = []
        for existing in target.glob("*.dockitem"):
            if existing.name not in canonical:
                try:
                    existing.unlink()
                    pruned.append(existing.name)
                except Exception as exc:
                    log(f"refresh_plank_skel: prune {existing.name} failed: {exc}")

        log(
            f"refresh_plank_skel: seeded={seeded} pruned={len(pruned)} "
            f"({pruned!r})"
        )
    except Exception as exc:
        log(f"refresh_plank_skel: top-level error: {exc}")


def _dconf_read_array(key: str) -> list[str] | None:
    """Read a string-array key from dconf and parse the GVariant text form.
    Returns None if the key doesn't exist or dconf is unreachable."""
    try:
        r = subprocess.run(
            ["dconf", "read", key],
            capture_output=True, text=True, timeout=5,
        )
        if r.returncode != 0 or not r.stdout.strip():
            return None
        # GVariant 'as' format: ['a', 'b']  — eval-style string.
        out = r.stdout.strip()
        # Strip outer brackets, split on ", " (with quote awareness).
        if not (out.startswith("[") and out.endswith("]")):
            return None
        inner = out[1:-1].strip()
        if not inner:
            return []
        items: list[str] = []
        for piece in inner.split(","):
            s = piece.strip()
            if (s.startswith("'") and s.endswith("'")) or (s.startswith('"') and s.endswith('"')):
                items.append(s[1:-1])
        return items
    except Exception:
        return None


def _dconf_read_scalar(key: str) -> str | None:
    """Read a scalar dconf key as text. Returns None on miss."""
    try:
        r = subprocess.run(
            ["dconf", "read", key],
            capture_output=True, text=True, timeout=5,
        )
        if r.returncode != 0 or not r.stdout.strip():
            return None
        out = r.stdout.strip()
        if (out.startswith("'") and out.endswith("'")):
            return out[1:-1]
        return out
    except Exception:
        return None


def load_dock_categories() -> dict[str, dict]:
    """Read /org/sudhanix/dock/categories/* from dconf; fall back to the
    embedded constants when the user-db isn't seeded yet."""
    try:
        r = subprocess.run(
            ["dconf", "list", "/org/sudhanix/dock/categories/"],
            capture_output=True, text=True, timeout=5,
        )
        if r.returncode != 0:
            return DOCK_CATEGORIES_FALLBACK()
        names = [n.rstrip("/") for n in r.stdout.split() if n.strip()]
        if not names:
            return DOCK_CATEGORIES_FALLBACK()
    except Exception:
        return DOCK_CATEGORIES_FALLBACK()

    cats: dict[str, dict] = {}
    for name in names:
        base = f"/org/sudhanix/dock/categories/{name}"
        items = _dconf_read_array(f"{base}/items") or []
        label = _dconf_read_scalar(f"{base}/label") or name.title()
        always_on = (_dconf_read_scalar(f"{base}/always-on") or "").lower() == "true"
        # Prefer `weight` (new); fall through to `order` (back-compat).
        weight_s = _dconf_read_scalar(f"{base}/weight")
        if weight_s is None:
            weight_s = _dconf_read_scalar(f"{base}/order") or "999"
        try:
            weight = int(weight_s)
        except ValueError:
            weight = 999
        default_enabled = (_dconf_read_scalar(f"{base}/default-enabled") or "false").lower() == "true"
        if always_on:
            default_enabled = True
        cats[name] = {
            "items": items,
            "label": label,
            "always_on": always_on,
            "weight": weight,
            "default_enabled": default_enabled,
        }
    return cats or DOCK_CATEGORIES_FALLBACK()


def ordered_category_keys(cats: dict[str, dict]) -> list[str]:
    """Sort by weight (preferred) or legacy `order` field."""
    return sorted(
        cats.keys(),
        key=lambda k: (
            cats[k].get("weight", cats[k].get("order", 999)),
            k,
        ),
    )

