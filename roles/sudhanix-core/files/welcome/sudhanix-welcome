# ─── CommandRunner ─────────────────────────────────────────────────────────
# Adapter over subprocess.run / subprocess.Popen. One default timeout, one
# log-on-failure policy, one place to mock. Errors never raise to the caller —
# inspect CommandResult.ok.


@dataclass(frozen=True)
class CommandResult:
    argv: list[str]
    returncode: int
    stdout: str
    stderr: str
    ok: bool
    error: Exception | None = None


class CommandRunner:
    def __init__(
        self,
        *,
        default_timeout: float = 5.0,
        logger: Callable[[str], None] | None = None,
    ) -> None:
        self._timeout = default_timeout
        # log() is defined later in the file; resolved at call time.
        self._logger = logger if logger is not None else (lambda m: log(m))

    def _emit(self, msg: str) -> None:
        try:
            self._logger(msg)
        except Exception:
            pass

    def run(
        self,
        argv: list[str],
        *,
        timeout: float | None = None,
        input_bytes: bytes | None = None,
    ) -> CommandResult:
        t = timeout if timeout is not None else self._timeout
        try:
            r = subprocess.run(
                argv,
                input=input_bytes,
                capture_output=True,
                timeout=t,
            )
        except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
            self._emit(f"run failed argv={argv!r}: {exc}")
            return CommandResult(argv=list(argv), returncode=-1, stdout="",
                                 stderr=str(exc), ok=False, error=exc)
        except Exception as exc:  # defensive
            self._emit(f"run exception argv={argv!r}: {exc}")
            return CommandResult(argv=list(argv), returncode=-1, stdout="",
                                 stderr=str(exc), ok=False, error=exc)
        ok = r.returncode == 0
        stdout = r.stdout.decode("utf-8", errors="replace") if isinstance(r.stdout, (bytes, bytearray)) else (r.stdout or "")
        stderr = r.stderr.decode("utf-8", errors="replace") if isinstance(r.stderr, (bytes, bytearray)) else (r.stderr or "")
        if not ok:
            self._emit(f"run rc={r.returncode} argv={argv!r} stderr={stderr.strip()!r}")
        return CommandResult(argv=list(argv), returncode=r.returncode,
                             stdout=stdout, stderr=stderr, ok=ok, error=None)

    def run_text(
        self,
        argv: list[str],
        *,
        timeout: float | None = None,
        input_text: str | None = None,
    ) -> CommandResult:
        t = timeout if timeout is not None else self._timeout
        try:
            r = subprocess.run(
                argv,
                input=input_text,
                capture_output=True,
                text=True,
                timeout=t,
            )
        except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
            self._emit(f"run_text failed argv={argv!r}: {exc}")
            return CommandResult(argv=list(argv), returncode=-1, stdout="",
                                 stderr=str(exc), ok=False, error=exc)
        except Exception as exc:
            self._emit(f"run_text exception argv={argv!r}: {exc}")
            return CommandResult(argv=list(argv), returncode=-1, stdout="",
                                 stderr=str(exc), ok=False, error=exc)
        ok = r.returncode == 0
        if not ok:
            self._emit(f"run_text rc={r.returncode} argv={argv!r} stderr={(r.stderr or '').strip()!r}")
        return CommandResult(argv=list(argv), returncode=r.returncode,
                             stdout=r.stdout or "", stderr=r.stderr or "",
                             ok=ok, error=None)

    def dispatch(self, argv: list[str]) -> None:
        """Fire-and-forget. Detached process group. Used for plank --replace."""
        try:
            subprocess.Popen(
                argv,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
            self._emit(f"dispatch ok argv={argv!r}")
        except FileNotFoundError as exc:
            self._emit(f"dispatch missing binary argv={argv!r}: {exc}")
        except Exception as exc:
            self._emit(f"dispatch exception argv={argv!r}: {exc}")


# ─── DconfRegistry ─────────────────────────────────────────────────────────
# Facade for dconf read / list / load. Owns GVariant encoding (string-array
# quoting, the @as [] empty-array form) and the dock-items / plank seed shape.


class DconfRegistry:
    SUDHANIX_DOCK_BASE = "/org/sudhanix/dock"
    PLANK_BASE = "/net/launchpad/plank"

    def __init__(self, runner: CommandRunner) -> None:
        self._runner = runner

    # ── Reads ──
    def read_scalar(self, key: str) -> str | None:
        r = self._runner.run_text(["dconf", "read", key])
        if not r.ok or not r.stdout.strip():
            return None
        out = r.stdout.strip()
        if out.startswith("'") and out.endswith("'"):
            return out[1:-1]
        return out

    def read_string_array(self, key: str) -> list[str] | None:
        r = self._runner.run_text(["dconf", "read", key])
        if not r.ok or not r.stdout.strip():
            return None
        out = r.stdout.strip()
        if not (out.startswith("[") and out.endswith("]")):
            return None
        inner = out[1:-1].strip()
        if not inner:
            return []
        items: list[str] = []
        for piece in inner.split(","):
            s = piece.strip()
            if (s.startswith("'") and s.endswith("'")) or (s.startswith('"') and s.endswith('"')):
                items.append(s[1:-1])
        return items

    def list_relative(self, base: str) -> list[str]:
        r = self._runner.run_text(["dconf", "list", base])
        if not r.ok:
            return []
        return [n.rstrip("/") for n in r.stdout.split() if n.strip()]

    # ── Writes ──
    def write_string_array(self, key: str, items: list[str]) -> bool:
        # Empty arrays need the @as type annotation so dconf can infer the
        # element type; non-empty literals use the canonical 'a','b' form.
        if items:
            quoted = ", ".join(f"'{i}'" for i in items)
            value = f"[{quoted}]"
        else:
            value = "@as []"
        r = self._runner.run_text(["dconf", "write", key, value])
        return r.ok

    def write_scalar_string(self, key: str, value: str) -> bool:
        r = self._runner.run_text(["dconf", "write", key, f"'{value}'"])
        return r.ok

    def write_bool(self, key: str, value: bool) -> bool:
        r = self._runner.run_text(["dconf", "write", key, "true" if value else "false"])
        return r.ok

    def load_ini_seed(self, base_path: str, seed_text: str) -> bool:
        r = self._runner.run(
            ["dconf", "load", base_path],
            input_bytes=seed_text.encode(),
        )
        return r.ok

    # ── Sudhanix-specific convenience ──
    def read_dock_categories(self) -> dict[str, dict] | None:
        names = self.list_relative(f"{self.SUDHANIX_DOCK_BASE}/categories/")
        # list_relative returns [] for both "no key" and "dconf unreachable".
        # Disambiguate: probe one well-known parent. If even the parent base
        # is empty AND the runner can't reach dconf at all, return None so
        # callers fall back to YAML; otherwise return whatever we found
        # (possibly an empty dict, meaning "reachable but no categories").
        if not names:
            probe = self._runner.run_text(["dconf", "list", "/"])
            if not probe.ok:
                return None
            return {}
        cats: dict[str, dict] = {}
        for name in names:
            base = f"{self.SUDHANIX_DOCK_BASE}/categories/{name}"
            items = self.read_string_array(f"{base}/items") or []
            label = self.read_scalar(f"{base}/label") or name.title()
            always_on = (self.read_scalar(f"{base}/always-on") or "").lower() == "true"
            weight_s = self.read_scalar(f"{base}/weight") or "999"
            try:
                weight = int(weight_s)
            except ValueError:
                weight = 999
            default_enabled = (self.read_scalar(f"{base}/default-enabled") or "false").lower() == "true"
            if always_on:
                default_enabled = True
            cats[name] = {
                "items": items,
                "label": label,
                "always_on": always_on,
                "weight": weight,
                "default_enabled": default_enabled,
            }
        return cats

    def write_dock_choices(self, choices: dict[str, bool]) -> bool:
        if not choices:
            return True
        lines = [f"{k}={'true' if v else 'false'}" for k, v in choices.items()]
        seed = "[enabled]\n" + "\n".join(lines) + "\n"
        return self.load_ini_seed(f"{self.SUDHANIX_DOCK_BASE}/", seed)

    def write_plank_dock_items(self, items: list[str], *, hide_mode: str = "none") -> bool:
        if items:
            quoted = ", ".join(f"'{i}'" for i in items)
            items_value = f"[{quoted}]"
        else:
            items_value = "@as []"
        seed = (
            "[docks/dock1]\n"
            f"dock-items={items_value}\n"
            f"hide-mode='{hide_mode}'\n"
        )
        return self.load_ini_seed(f"{self.PLANK_BASE}/", seed)


# ─── CustomizeConfig + typed records ──────────────────────────────────────
# Frozen dataclasses for theme / browser / dock anchor / dock category +
# CustomizeConfig.load(path) which folds YAML + last-resort baked-in defaults.
# load() never raises — config-file glitches must not block the panel.
#
# Forward-compat: unknown YAML fields are ignored without warning (Task 3
# acceptance #4 risk note in the plan).


@dataclass(frozen=True)
class Theme:
    id: str
    label: str
    gtk: str
    icon: str
    xfwm: str

    def triple(self) -> tuple[str, str, str]:
        return (self.gtk, self.icon, self.xfwm)

    @classmethod
    def from_raw(cls, raw: dict) -> "Theme | None":
        if not isinstance(raw, dict):
            return None
        tid = raw.get("id")
        if not isinstance(tid, str) or not tid:
            return None
        return cls(
            id=tid,
            label=str(raw.get("label") or tid),
            gtk=str(raw.get("gtk") or ""),
            icon=str(raw.get("icon") or ""),
            xfwm=str(raw.get("xfwm") or ""),
        )


@dataclass(frozen=True)
class Browser:
    id: str
    label: str
    desktop: str

    @classmethod
    def from_raw(cls, raw: dict) -> "Browser | None":
        if not isinstance(raw, dict):
            return None
        bid = raw.get("id")
        if not isinstance(bid, str) or not bid:
            return None
        return cls(
            id=bid,
            label=str(raw.get("label") or bid),
            desktop=str(raw.get("desktop") or ""),
        )


@dataclass(frozen=True)
class DockAnchor:
    item: str
    weight: int

    @classmethod
    def from_raw(cls, raw: dict) -> "DockAnchor | None":
        if not isinstance(raw, dict):
            return None
        item = raw.get("item")
        if not isinstance(item, str) or not item:
            return None
        try:
            w = int(raw.get("weight", 0))
        except (TypeError, ValueError):
            w = 0
        return cls(item=item, weight=w)


@dataclass(frozen=True)
class DockCategory:
    key: str
    label: str
    items: tuple[str, ...]
    always_on: bool
    weight: int
    default_enabled: bool

    def as_dict(self) -> dict:
        return {
            "items": list(self.items),
            "label": self.label,
            "always_on": self.always_on,
            "weight": self.weight,
            "default_enabled": self.default_enabled,
        }

    @classmethod
    def from_raw(cls, key: str, raw: dict) -> "DockCategory | None":
        if not isinstance(raw, dict):
            return None
        items_raw = raw.get("items") or []
        if not isinstance(items_raw, list):
            items_raw = []
        try:
            weight = int(raw.get("weight", 999))
        except (TypeError, ValueError):
            weight = 999
        always_on = bool(raw.get("always_on", False))
        default_enabled = bool(raw.get("default_enabled", False))
        if always_on:
            default_enabled = True
        return cls(
            key=key,
            label=str(raw.get("label") or key.title()),
            items=tuple(str(i) for i in items_raw),
            always_on=always_on,
            weight=weight,
            default_enabled=default_enabled,
        )

    @classmethod
    def from_dconf_dict(cls, key: str, raw: dict) -> "DockCategory":
        """Lossy build from the registry's dict shape (which is itself derived
        from dconf scalars/arrays). Tolerant of missing keys."""
        return cls(
            key=key,
            label=str(raw.get("label") or key.title()),
            items=tuple(raw.get("items") or []),
            always_on=bool(raw.get("always_on", False)),
            weight=int(raw.get("weight", 999)),
            default_enabled=bool(raw.get("default_enabled", False))
            or bool(raw.get("always_on", False)),
        )


@dataclass(frozen=True)
class CustomizeConfig:
    themes: tuple[Theme, ...]
    default_theme_id: str
    browsers: tuple[Browser, ...]
    default_browser_id: str
    dock_anchors: tuple[DockAnchor, ...]
    default_dock_categories: dict[str, DockCategory] = field(default_factory=dict)

    def theme(self, theme_id: str) -> Theme | None:
        for t in self.themes:
            if t.id == theme_id:
                return t
        return None

    def default_theme(self) -> Theme:
        t = self.theme(self.default_theme_id)
        if t is not None:
            return t
        if self.themes:
            return self.themes[0]
        return Theme(id="Dark", label="Dark", gtk="WhiteSur-Dark",
                     icon="WhiteSur-dark", xfwm="WhiteSur-Dark")

    def browser(self, browser_id: str) -> Browser | None:
        for b in self.browsers:
            if b.id == browser_id:
                return b
        return None

    def default_browser(self) -> Browser:
        b = self.browser(self.default_browser_id)
        if b is not None:
            return b
        if self.browsers:
            return self.browsers[0]
        return Browser(id="Chrome", label="Chrome",
                       desktop="google-chrome.desktop")

    def theme_triple(self, theme_id: str) -> tuple[str, str, str]:
        t = self.theme(theme_id) or self.default_theme()
        return t.triple()

    def browser_desktop(self, browser_id: str) -> str:
        b = self.browser(browser_id) or self.default_browser()
        return b.desktop

    @classmethod
    def load(cls, path: str | Path = CUSTOMIZE_PATH) -> "CustomizeConfig":
        raw = cls._read_yaml(str(path))
        if not raw:
            return _LAST_RESORT_CONFIG

        # Themes
        theme_rows = raw.get("themes")
        themes_t: list[Theme] = []
        if isinstance(theme_rows, list):
            for entry in theme_rows:
                t = Theme.from_raw(entry) if isinstance(entry, dict) else None
                if t is not None:
                    themes_t.append(t)
        if not themes_t:
            themes_t = list(_LAST_RESORT_CONFIG.themes)
        default_theme = str(raw.get("default_theme") or _LAST_RESORT_CONFIG.default_theme_id)

        # Browsers
        browser_rows = raw.get("browsers")
        browsers_t: list[Browser] = []
        if isinstance(browser_rows, list):
            for entry in browser_rows:
                b = Browser.from_raw(entry) if isinstance(entry, dict) else None
                if b is not None:
                    browsers_t.append(b)
        if not browsers_t:
            browsers_t = list(_LAST_RESORT_CONFIG.browsers)
        default_browser = str(raw.get("default_browser") or _LAST_RESORT_CONFIG.default_browser_id)

        # Dock anchors
        anchors_raw = raw.get("dock_anchors")
        anchors_t: list[DockAnchor] = []
        if isinstance(anchors_raw, list):
            for entry in anchors_raw:
                a = DockAnchor.from_raw(entry) if isinstance(entry, dict) else None
                if a is not None:
                    anchors_t.append(a)
        if not anchors_t:
            anchors_t = list(_LAST_RESORT_CONFIG.dock_anchors)
        anchors_t.sort(key=lambda a: a.weight)

        # Dock categories
        cats_raw = raw.get("dock_categories")
        cats_t: dict[str, DockCategory] = {}
        if isinstance(cats_raw, dict):
            for k, v in cats_raw.items():
                c = DockCategory.from_raw(str(k), v) if isinstance(v, dict) else None
                if c is not None:
                    cats_t[c.key] = c
        if not cats_t:
            cats_t = dict(_LAST_RESORT_CONFIG.default_dock_categories)

        return cls(
            themes=tuple(themes_t),
            default_theme_id=default_theme,
            browsers=tuple(browsers_t),
            default_browser_id=default_browser,
            dock_anchors=tuple(anchors_t),
            default_dock_categories=cats_t,
        )

    @staticmethod
    def _read_yaml(path: str) -> dict | None:
        if not _HAVE_YAML:
            return None
        try:
            with open(path, encoding="utf-8") as fh:
                data = yaml.safe_load(fh)
            return data if isinstance(data, dict) else None
        except FileNotFoundError:
            return None
        except Exception as exc:
            log(f"customize.yml unreadable ({path}): {exc}")
            return None


