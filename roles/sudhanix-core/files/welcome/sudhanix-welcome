            f"<span weight='600' size='11500'>"
            f"{GLib.markup_escape_text(card_title)}</span>"
        )
        t.set_xalign(0)
        t.set_line_wrap(True)
        t.set_max_width_chars(28)
        text_col.pack_start(t, False, False, 0)

        b = Gtk.Label(label=card_body)
        b.get_style_context().add_class("dim-label")
