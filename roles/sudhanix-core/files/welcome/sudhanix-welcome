    def _on_theme_clicked(self, btn: Gtk.Button, label: str) -> None:
        self._set_theme_active(label)
        # Live preview: swap the welcome panel's own CSS so the user sees the
        # change without leaving the Customization page. Apply still pushes
        # through to xfconf for system-wide effect.
        apply_css_safe(label)

    def _update_chip_style(self, chip: Gtk.ToggleButton) -> None:
        ctx = chip.get_style_context()
        if chip.get_active():
            ctx.add_class("active")
        else:
            ctx.remove_class("active")

    def _on_chip_toggled(self, chip: Gtk.ToggleButton, label: str) -> None:
        self._update_chip_style(chip)

    def _set_browser_active(self, active: str) -> None:
        self._selected_browser = active
        for label, btn in self._browser_buttons.items():
            ctx = btn.get_style_context()
            if label == active:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")

    def _on_browser_clicked(self, btn: Gtk.Button, label: str) -> None:
        self._set_browser_active(label)

    def _on_apply(self, _btn: Gtk.Button) -> None:
        values = {
            "theme": self._selected_theme,
            "wallpaper_rotate": self._wp_switch.get_active(),
            "dock": {
                label: chip.get_active()
                for label, chip in self._dock_chips.items()
            },
            "browser": self._selected_browser,
        }
        apply_settings(values)
        # Tell the surrounding WelcomeWindow that the user customised
        # explicitly — otherwise dismiss would re-apply the all-categories
        # default and stomp the user's chip choices.
        top = self.get_toplevel()
        if top is not None and hasattr(top, "applied_during_session"):
            top.applied_during_session = True  # type: ignore[attr-defined]
        # Inline-page feedback: Apply confirms by updating the button label.
        # Reset on next change is out of scope here — apply is idempotent.
        self._apply_btn.set_label("Applied")
        self._apply_btn.set_sensitive(False)
        GLib.timeout_add_seconds(2, self._reset_apply_button)

    def _reset_apply_button(self) -> bool:
        self._apply_btn.set_label("Apply")
        self._apply_btn.set_sensitive(True)
        return False  # one-shot


