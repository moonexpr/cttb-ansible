                first_row = row

        nav_list.connect("row-selected", self._on_nav_row_selected)
        if first_row is not None:
            nav_list.select_row(first_row)

        inner.pack_start(nav_list, False, False, 0)

        # Spacer pushes the build-stamp footer to the bottom.
        inner.pack_start(Gtk.Box(), True, True, 0)

        # Sidebar footer
        foot_sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        foot_sep.set_margin_top(14)
        foot_sep.set_margin_bottom(12)
        inner.pack_start(foot_sep, False, False, 0)

        foot = Gtk.Label(label="CTTB lab network\nbuild 26.04 · spring 2026")
