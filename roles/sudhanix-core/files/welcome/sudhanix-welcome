    def _build_right_pane(self) -> Gtk.Box:
        """Stack on top, persistent action row at the bottom."""
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Stack expands to fill available height.
        right.pack_start(self._stack, True, True, 0)

        # Persistent action row at the bottom of the right pane (lives outside
        # the stack so Continue is reachable from every page).
        action_wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        action_wrap.set_margin_start(36)
        action_wrap.set_margin_end(36)
        action_wrap.set_margin_bottom(26)

        action_sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
