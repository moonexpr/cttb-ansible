class WelcomeWindow(Gtk.Window):
    """
    960x540 main panel.
    Left sidebar (240px) + right pane (Gtk.Stack on top, persistent action row
    at the bottom). Sidebar ListBox row-selection drives stack page switch.
    Visual / copy redesign tracked in #4; this layout is the wiring layer
    landed in #51.
    """

    def __init__(
        self,
        *,
        coordinator: SettingsCoordinator,
        config: CustomizeConfig,
        registry: DconfRegistry,
        dock: PlankDock,
        theme_preview: ThemePreview,
        user_name: str = "",
    ) -> None:
        super().__init__(title="Welcome")
        self.set_name("welcome-window")
        self.set_default_size(960, 540)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.dismiss_on_continue = True  # checkbox default
        # Did the user click Apply on the Customization page during this
        # session? If not, we apply the all-categories default at dismiss
        # so the dock comes up populated rather than empty + autohidden.
        self.applied_during_session = False

        self._coordinator = coordinator
        self._config = config
        self._registry = registry
        self._dock = dock
        self._theme_preview = theme_preview
        self._user_name = user_name

        # Resolve dock categories + prior choices once, hand both to the page
        # as pre-loaded data (UI doesn't query dconf directly).
        dock_cats_raw = self._registry.read_dock_categories()
        if dock_cats_raw is None or not dock_cats_raw:
            dock_categories = dict(self._config.default_dock_categories)
        else:
            dock_categories = {
                k: DockCategory.from_dconf_dict(k, v)
                for k, v in dock_cats_raw.items()
            }
        prior_choices: dict[str, bool] = {}
        for k in dock_categories.keys():
            v = self._registry.read_scalar(f"/org/sudhanix/dock/enabled/{k}")
            if v is not None:
                prior_choices[k] = v.lower() == "true"
        self._dock_categories = dock_categories

        self.connect("destroy", self._on_destroy)

        # Top-level horizontal split
        hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.add(hbox)

        # Stack must exist before sidebar is built (sidebar binds to it).
        self._stack = Gtk.Stack()
        self._stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self._stack.set_transition_duration(180)
        self._stack.add_named(self._build_welcome_page(), PAGE_WELCOME)
        self._stack.add_named(self._build_whats_new_page(), PAGE_WHATS_NEW)
        self._stack.add_named(self._build_quick_tour_page(), PAGE_QUICK_TOUR)
        self._stack.add_named(
            CustomizationPage(
                config=self._config,
                dock_categories=dock_categories,
                prior_choices=prior_choices,
                coordinator=self._coordinator,
                theme_preview=self._theme_preview,
                window=self,
            ),
            PAGE_CUSTOMIZATION,
        )
        self._stack.add_named(AboutPage(), PAGE_ABOUT)
        self._stack.set_visible_child_name(PAGE_WELCOME)

        hbox.pack_start(self._build_sidebar(), False, False, 0)
        hbox.pack_start(self._build_right_pane(), True, True, 0)

    def _build_sidebar(self) -> Gtk.Box:
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        sidebar.set_name("sidebar")
        sidebar.set_size_request(240, -1)
        sidebar.set_border_width(0)

        # Hero wordmark — packed directly into the sidebar (NOT into the
        # padded `inner` box) so it breaks the margin and fills the
        # top-left. Source asset is 1200x700; scale to sidebar width
        # (240px) → height ~140px, aspect preserved.
        wordmark_ok = False
        try:
            wordmark_pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                WORDMARK_PATH, 240, -1, True
            )
            wordmark_img = Gtk.Image.new_from_pixbuf(wordmark_pb)
            wordmark_img.set_halign(Gtk.Align.START)
            wordmark_img.set_valign(Gtk.Align.START)
            sidebar.pack_start(wordmark_img, False, False, 0)
            wordmark_ok = True
        except Exception as exc:
            log(f"wordmark asset missing or unreadable ({WORDMARK_PATH}): {exc}")

        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        # Tight top padding when the hero is present (it already gives
        # visual breathing room); fall back to original 26 if hero failed.
        inner.set_margin_top(6 if wordmark_ok else 26)
        inner.set_margin_bottom(18)
        inner.set_margin_start(18)
        inner.set_margin_end(18)
        sidebar.pack_start(inner, True, True, 0)

        # Text wordmark fallback (only when the image asset failed to load).
        if not wordmark_ok:
            wordmark_lbl = Gtk.Label()
            wordmark_lbl.set_markup(
                "<span weight='600' size='15000'>"
                "Sudha<span color='#D99A3C'>*</span>nix"
                "</span>"
            )
            wordmark_lbl.set_xalign(0)
            wordmark_lbl.set_margin_bottom(8)
            inner.pack_start(wordmark_lbl, False, False, 0)

        ver = Gtk.Label(label="version 26")
        ver.get_style_context().add_class("dim-label")
        ver.set_xalign(0)
        ver.set_margin_bottom(18)
        inner.pack_start(ver, False, False, 0)

        sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        sep.set_margin_bottom(14)
        inner.pack_start(sep, False, False, 0)

        # "Get started" section label
        nav_heading = Gtk.Label(label="GET STARTED")
        nav_heading.get_style_context().add_class("dim-label")
        nav_heading.set_xalign(0)
        nav_heading.set_margin_bottom(6)
        inner.pack_start(nav_heading, False, False, 0)

        # Nav list — every row routes to a Gtk.Stack page (#51).
        nav_list = Gtk.ListBox()
        nav_list.get_style_context().add_class("navigation-sidebar")
        nav_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        nav_list.set_activate_on_single_click(True)

        first_row: Gtk.ListBoxRow | None = None
        for page_name, nav_label, icon_name in SIDEBAR_NAV:
            row = Gtk.ListBoxRow()
            row.page_name = page_name  # type: ignore[attr-defined]

            row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            icon = welcome_icon(icon_name, 16)
            if icon is not None:
                icon.set_valign(Gtk.Align.CENTER)
                row_box.pack_start(icon, False, False, 0)
            else:
                # Reserve the icon slot so labels still align when an SVG
                # is missing — better than rows of inconsistent indent.
                spacer = Gtk.Box()
                spacer.set_size_request(16, 16)
                row_box.pack_start(spacer, False, False, 0)

            lbl = Gtk.Label(label=nav_label)
            lbl.set_xalign(0)
            row_box.pack_start(lbl, True, True, 0)
            row.add(row_box)

            nav_list.add(row)
            if first_row is None:
                first_row = row

        nav_list.connect("row-selected", self._on_nav_row_selected)
        if first_row is not None:
            nav_list.select_row(first_row)

