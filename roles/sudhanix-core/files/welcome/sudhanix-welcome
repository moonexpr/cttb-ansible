# ── CSS injection ─────────────────────────────────────────────────────────────
def apply_css_safe() -> None:
    """Apply CSS; log and continue on failure (doesn't block the panel)."""
    try:
        provider = Gtk.CssProvider()
        provider.load_from_data(GTK_CSS)
        from gi.repository import Gdk  # noqa: PLC0415
        screen = Gdk.Screen.get_default()
        if screen:
            Gtk.StyleContext.add_provider_for_screen(
                screen,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )
    except Exception as exc:
        log(f"CSS provider failed (continuing without theme): {exc}")


# ── Entry point ───────────────────────────────────────────────────────────────
def main() -> int:
    if "DISPLAY" not in os.environ and "WAYLAND_DISPLAY" not in os.environ:
        return 0

    uid = os.getuid()
    try:
        username = pwd.getpwuid(uid).pw_name
    except KeyError:
        log(f"no passwd entry for uid {uid}")
        return 0

    user_dn = LDAP_DN_TEMPLATE.format(uid=username)

    # SUDHANIX_WELCOME_FORCE bypasses the dismissal/token gate so vajra's
    # test_welcome_preview "Show window" action and any future preview path
    # can render the panel regardless of LDAP state. The Continue button still
    # writes the dismissal flag if the user accepts; the toolset can clear it.
    force = os.environ.get("SUDHANIX_WELCOME_FORCE", "").strip().lower() in ("1", "true", "yes")

    if not force:
        tok = token_path(uid)
        if tok is None:
            log("no cached PAM token; can't reach LDAP this session")
            return 0

        state = already_dismissed(user_dn, tok)
        if state is True:
            return 0
        if state is None:
            # Couldn't query LDAP — don't pester the user since we can't
            # remember their dismissal anyway.
            return 0

    apply_css_safe()

    win = WelcomeWindow()
    win.show_all()
    Gtk.main()

    if win.dismiss_on_continue and not force:
        try:
            write_dismissal(user_dn, tok)
        except Exception as exc:
            log(f"write_dismissal failed: {exc}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
