        card.pack_start(text_col, True, True, 0)
        grid.attach(card, col, row, 1, 1)

    page.pack_start(grid, False, False, 0)

    # Footer: wiki link.
    footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
