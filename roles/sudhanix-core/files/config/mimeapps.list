# /etc/xdg/mimeapps.list — system-wide default-applications map.
#
# Lubuntu 24.04 ships no system mimeapps.list, so the resolution chain
# falls through to /usr/share/applications/mimeinfo.cache which is
# alphabetical-first per MIME — placing LibreOffice Writer ahead of
# gedit for text/plain and friends. The role pins the operator's chosen
# defaults here so a freshly-imaged host gets the right behaviour
# without per-user setup.
#
# Per-user overrides at ~/.config/mimeapps.list still win — this is the
# fallback the freedesktop spec consults next.

[Default Applications]
text/plain=org.gnome.gedit.desktop
text/markdown=org.gnome.gedit.desktop
text/x-markdown=org.gnome.gedit.desktop
text/x-shellscript=org.gnome.gedit.desktop
text/x-python=org.gnome.gedit.desktop
text/x-perl=org.gnome.gedit.desktop
text/x-c=org.gnome.gedit.desktop
text/x-c++=org.gnome.gedit.desktop
text/x-log=org.gnome.gedit.desktop
text/x-yaml=org.gnome.gedit.desktop
application/x-yaml=org.gnome.gedit.desktop
application/x-shellscript=org.gnome.gedit.desktop
application/x-desktop=org.gnome.gedit.desktop
application/json=org.gnome.gedit.desktop
application/x-ndjson=org.gnome.gedit.desktop

# Browser handles — points at the role-displayed Chrome .desktop, not
# Google's hidden com.google.Chrome.desktop (NoDisplay=true) which the
# XDG portal autodefault sometimes lands on. See #62 investigation.
text/html=google-chrome.desktop
application/xhtml+xml=google-chrome.desktop
x-scheme-handler/http=google-chrome.desktop
x-scheme-handler/https=google-chrome.desktop
x-scheme-handler/about=google-chrome.desktop
x-scheme-handler/unknown=google-chrome.desktop
x-scheme-handler/mailto=thunderbird.desktop

# gh-73: viewers. A fresh lubuntu-core had image/* + application/pdf
# pointed at Chrome and video/mp4 at an uninstalled vlc.desktop, so
# double-click "opened on the desktop" or did nothing. Pin the
# installed single-purpose viewers (gpicview / mpv / evince).
image/jpeg=gpicview.desktop
image/png=gpicview.desktop
image/gif=gpicview.desktop
image/bmp=gpicview.desktop
image/tiff=gpicview.desktop
image/webp=gpicview.desktop
image/x-xpixmap=gpicview.desktop
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
video/quicktime=mpv.desktop
video/x-msvideo=mpv.desktop
video/mpeg=mpv.desktop
application/pdf=org.gnome.Evince.desktop
