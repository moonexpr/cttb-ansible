# /etc/dconf/db/site.d/00-plank-dock1
#
# System default for the Plank dock — empty and auto-hidden until the
# Sudhanix welcome panel populates it. The welcome panel writes its
# computed dock-items + hide-mode=0 to the user's user-db on Apply (or
# on dismiss-without-apply, which enables all categories), so the dock
# only becomes visible once the user has either chosen or accepted the
# default. Per-user writes still beat system-db:site (see
# /etc/dconf/profile/user), so a user can rearrange or hide the dock
# afterwards and the change persists in their own dconf store.
#
# dock-items=[] explicitly (rather than absent) suppresses Plank's
# first-run auto-detect — Plank treats a present-but-empty array as
# "no launchers, not 'never configured'" and won't write its own.

[net/launchpad/plank/docks/dock1]
# `@as []` is the GVariant type annotation forcing "array of strings"
# on the empty list — without it `dconf update` errors out unable to
# infer the array element type.
dock-items=@as []
hide-mode='auto'
