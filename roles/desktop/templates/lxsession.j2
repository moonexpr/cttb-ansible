[General]
window_manager=xfwm4
leave_confirmation=false

[Environment]
GTK_CSD=0
GTK_OVERLAY_SCROLLING=0
BROWSER=firefox
TERM=lxterminal

[Mouse]
cursor_size=18
cursor_theme={{cursor_theme}}
acc_factor=20
acc_threshold=10
left_handed=false

[Keyboard]
delay=500
interval=30
beep=true

[Font]
antialias=true
hinting=true
dpi=96
