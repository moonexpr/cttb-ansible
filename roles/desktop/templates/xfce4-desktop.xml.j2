<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitorscreen" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="5"/>
          <property name="last-image" type="string" value="{{ desktop_wallpaper_dir }}"/>
          <property name="image-show" type="bool" value="true"/>
          <property name="image-period" type="int" value="{{ desktop_wallpaper_interval_minutes }}"/>
          <property name="image-random-order" type="bool" value="true"/>
        </property>
      </property>
    </property>
  </property>
  <property name="desktop-icons" type="empty">
    <property name="use-custom-font-size" type="bool" value="true"/>
    <property name="font-size" type="double" value="11"/>
    <property name="show-tooltips" type="bool" value="true"/>
    <property name="show-icon-label-shadows" type="bool" value="true"/>
  </property>
</channel>
