[Do not allow any user to enable/disable/modify networking]
Identity=unix-user:*
Action=org.freedesktop.NetworkManager.enable-disable-network;org.freedesktop.NetworkManager.settings.modify.system
ResultAny=no
ResultInactive=no
ResultActive=no

[Allow the "administrator" account to enable/disable/modify networking]
Identity=unix-user:administrator
Action=org.freedesktop.NetworkManager.enable-disable-network;org.freedesktop.NetworkManager.settings.modify.system
ResultAny=no
ResultInactive=no
ResultActive=yes
