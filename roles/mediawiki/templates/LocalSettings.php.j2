<?php
# {{ ansible_managed }}
# MediaWiki LocalSettings — generated by Ansible. Do not edit on the container.

## Core settings
$wgSitename = "{{ mediawiki_site_name }}";
$wgServer = "{{ mediawiki_server }}";
$wgScriptPath = "{{ mediawiki_script_path }}";
$wgArticlePath = "/wiki/$1";

## Database
$wgDBtype = "mysql";
$wgDBserver = "localhost";
$wgDBname = "{{ mediawiki_db_name }}";
$wgDBuser = "{{ mediawiki_db_user }}";
$wgDBpassword = "{{ mediawiki_db_password }}";
$wgDBprefix = "{{ mediawiki_db_prefix }}";
$wgDBTableOptions = "ENGINE=InnoDB, DEFAULT CHARSET=utf8mb4";

## Paths
$wgResourceBasePath = "{{ mediawiki_script_path }}";
$wgUploadPath = "$wgScriptPath/images";
$wgUploadDirectory = "{{ mediawiki_install_dir }}/images";
$wgEnableUploads = true;

## File upload — allow SVG with title overlay, rasterise via ImageMagick
$wgFileExtensions[] = "svg";
$wgAllowTitlesInSVG = true;
$wgSVGConverter = "ImageMagick";

## Logo
$wgLogos = [
    "1x" => "$wgResourceBasePath/resources/assets/cttb.png",
    "icon" => "$wgResourceBasePath/resources/assets/cttb.png",
];

## Caching
$wgMainCacheType = {{ mediawiki_main_cache_type }};

## Skins — Vector 2022 with wider content for figures
wfLoadSkin( "Vector" );
wfLoadSkin( "MonoBook" );
wfLoadSkin( "Timeless" );
wfLoadSkin( "MinervaNeue" );
$wgDefaultSkin = "vector-2022";
$wgVectorDefaultSkinVersion = "2";
$wgVectorDefaultSkinVersionForExistingAccounts = "2";
$wgDefaultUserOptions["skin"] = "vector-2022";
$wgDefaultUserOptions["VectorSkinVersion"] = "2";

{% if mediawiki_extra_namespaces %}
## Custom namespaces — define before extensions load so Lockdown sees them
{% for ns in mediawiki_extra_namespaces %}
define( "NS_{{ ns.name | upper | replace('_TALK', '_TALK') }}", {{ ns.id }} );
$wgExtraNamespaces[{{ ns.id }}] = "{{ ns.name }}";
{% endfor %}

## Treat content (even-ID) custom namespaces as real content: include them in
## default search (so a bare "Onboarding" finds IT:CTTB IT Member Onboarding…)
## and in $wgContentNamespaces (so page counts and Special:Random behave).
## Lockdown still hides results from users who lack the read group.
{% for ns in mediawiki_extra_namespaces if ns.id is even %}
$wgContentNamespaces[] = NS_{{ ns.name | upper }};
$wgNamespacesToBeSearchedDefault[NS_{{ ns.name | upper }}] = true;
{% endfor %}

{% endif %}
## Extensions
{% for ext in mediawiki_extensions %}
wfLoadExtension( "{{ ext }}" );
{% endfor %}
{% for ext in mediawiki_extdist_extensions %}
wfLoadExtension( "{{ ext.name }}" );
{% endfor %}

## Scribunto — use the standalone Lua interpreter (LuaSandbox PHP module not packaged for 8.3)
$wgScribuntoDefaultEngine = "luastandalone";
$wgScribuntoEngineConf["luastandalone"]["luaPath"] = "{{ mediawiki_scribunto_lua_path }}";

## VisualEditor config — single "Edit" tab using VisualEditor
$wgDefaultUserOptions["visualeditor-editor"] = "visualeditor";
$wgDefaultUserOptions["visualeditor-enable"] = 1;
$wgVisualEditorUseSingleEditTab = true;
$wgDefaultUserOptions["visualeditor-tabs"] = "prefer-ve";
$wgVisualEditorEnableWikitext = false;
$wgVisualEditorEnableWikitextEditor = false;

## Security
$wgSecretKey = "{{ mediawiki_secret_key }}";
$wgUpgradeKey = "{{ mediawiki_upgrade_key }}";

## Permissions — internal wiki, login required to edit
$wgGroupPermissions['*']['edit'] = false;
$wgGroupPermissions['*']['createaccount'] = false;

{% if mediawiki_user_groups %}
## Custom user groups — only need read; explicit grant for edit so Lockdown can layer
{% for grp in mediawiki_user_groups %}
$wgGroupPermissions['{{ grp }}']['read']  = true;
$wgGroupPermissions['{{ grp }}']['edit']  = true;
$wgGroupPermissions['{{ grp }}']['move']  = true;
$wgGroupPermissions['{{ grp }}']['createpage'] = true;
$wgAddGroups['sysop'][] = '{{ grp }}';
$wgRemoveGroups['sysop'][] = '{{ grp }}';
{% endfor %}

{% endif %}
{% if mediawiki_lockdown %}
## Lockdown — per-namespace read/edit/move restrictions
{% for ns_name, actions in mediawiki_lockdown.items() %}
{% for action, groups in actions.items() %}
$wgNamespacePermissionLockdown[NS_{{ ns_name | upper }}]['{{ action }}'] = [{% for g in groups %}'{{ g }}'{% if not loop.last %}, {% endif %}{% endfor %}];
{% endfor %}
{% endfor %}

{% endif %}
## Email (disabled — internal wiki)
$wgEnableEmail = false;

## Misc
$wgLanguageCode = "en";
$wgLocaltimezone = "America/Los_Angeles";

## Tabs: rename "View history" to "History"
$wgHooks["SkinTemplateNavigation::Universal"][] = function ( $skin, &$links ) {
    if ( isset( $links["views"]["history"] ) ) {
        $links["views"]["history"]["text"] = "History";
    }
};

## Load City Lights dark theme CSS
$wgHooks["BeforePageDisplay"][] = function ( $out ) {
    $out->addStyle( $out->getConfig()->get( 'ScriptPath' ) . '/resources/assets/cttb-dark.css' );
};

{% if mediawiki_lockdown and mediawiki_lockdown_search_visible %}
## Search visibility override — keep restricted titles in the search bar.
##
## Lockdown's onSearchableNamespaces strips restricted namespaces from the
## searchable list, and onSearchGetNearMatchComplete nulls out exact-title
## "Go" matches for users without the read group. We register hooks after
## Lockdown to reverse both filters so every page surfaces in Special:Search
## hits and the main search bar dropdown. Reading is still blocked by
## Lockdown's getUserPermissionsErrors — clicking a restricted hit lands on
## the badaccess-groups error page.
$wgHooks["SearchableNamespaces"][] = function ( &$searchableNs ) {
{% for ns in mediawiki_extra_namespaces %}
    $searchableNs[NS_{{ ns.name | upper }}] = "{{ ns.name }}";
{% endfor %}
};

$wgHooks["SearchGetNearMatchComplete"][] = function ( $searchterm, &$title ) {
    if ( $title === null ) {
        $candidate = Title::newFromText( $searchterm );
        if ( $candidate && $candidate->exists() ) {
            $title = $candidate;
        }
    }
};

{% endif %}
{% if mediawiki_lockdown %}
## Decorate links to read-restricted pages with a lock prefix.
## Parser-cache-safe two-pass design:
##   pass 1 — HtmlPageLinkRendererBegin (cached): mark every link to a
##     locked-down namespace with class="cttb-restricted-link", a
##     data-restrict-groups attribute listing required groups, and a
##     <span class="cttb-lock"> wrapper around the 🔒 prefix. The output
##     is identical for everyone, so parser cache hits are correct.
##   pass 2 — BeforePageDisplay (per-request): stamp the <body> with one
##     `cttb-user-in-<group>` class per group the current viewer is in.
##     CSS in MediaWiki:Common.css then hides .cttb-lock and restores
##     normal link colour when the body class matches a required group.
$wgHooks["HtmlPageLinkRendererBegin"][] = function ( $linkRenderer, $target, &$text, &$customAttribs, &$query, &$ret ) {
    global $wgNamespacePermissionLockdown;
    $ns = $target->getNamespace();
    if ( !isset( $wgNamespacePermissionLockdown[$ns]["read"] ) ) {
        return true;
    }
    $allowed = $wgNamespacePermissionLockdown[$ns]["read"];
    $customAttribs["class"] = trim( ( $customAttribs["class"] ?? "" ) . " cttb-restricted-link" );
    $customAttribs["data-restrict-groups"] = implode( " ", $allowed );
    $customAttribs["title"] = ( isset( $customAttribs["title"] ) ? $customAttribs["title"] . " — " : "" )
        . "Restricted: requires membership in " . implode( ", ", $allowed );
    $lockSpan = '<span class="cttb-lock" aria-hidden="true">&#x1F512; </span>';
    if ( $text === null ) {
        $text = new HtmlArmor( $lockSpan . htmlspecialchars( $target->getPrefixedText() ) );
    } elseif ( is_string( $text ) ) {
        $text = new HtmlArmor( $lockSpan . htmlspecialchars( $text ) );
    } elseif ( class_exists( "HtmlArmor" ) && $text instanceof HtmlArmor ) {
        $text = new HtmlArmor( $lockSpan . HtmlArmor::getHtml( $text ) );
    }
    return true;
};

## Per-request body class: cttb-user-in-<group> for each effective group.
## The lock-prefix CSS keys on this to hide locks for permitted users.
$wgHooks["OutputPageBodyAttributes"][] = function ( $out, $skin, &$bodyAttrs ) {
    $userGroupManager = MediaWiki\MediaWikiServices::getInstance()->getUserGroupManager();
    $groups = $userGroupManager->getUserEffectiveGroups( $out->getUser() );
    $extra = [];
    foreach ( $groups as $g ) {
        $clean = preg_replace( "/[^a-z0-9_-]/i", "", $g );
        if ( $clean !== "" ) {
            $extra[] = "cttb-user-in-" . $clean;
        }
    }
    $bodyAttrs["class"] = trim( ( $bodyAttrs["class"] ?? "" ) . " " . implode( " ", $extra ) );
};

{% endif %}
## Sitenotice — bump $wgSiteNoticeId to force re-display after dismiss
$wgSiteNoticeId = {{ mediawiki_site_notice_id }};
