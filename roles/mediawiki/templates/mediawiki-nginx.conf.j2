server {
    listen 80;
    server_name {{ mediawiki_server_name }};

    root /var/www/html;
    index index.php index.html;

    client_max_body_size 20M;

    # Short URL: /wiki/Page_Name -> /w/index.php
    location /wiki/ {
        rewrite ^/wiki/(.*)$ /w/index.php?title=$1&$args last;
    }

    # Redirect bare / to wiki main page
    location = / {
        return 301 /wiki/Main_Page;
    }

    # MediaWiki PHP files
    location ~ ^/w/(index|load|api|thumb|opensearch_desc|rest)\.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/mediawiki.sock;
    }

    # Static assets
    location ^~ /w/skins/   { }
    location ^~ /w/resources/ { }
    location ^~ /w/images/  { }
    location ^~ /w/extensions/ {
        location ~* \.php$ { return 403; }
    }

    # Static files outside wiki (PDF, files/, etc.)
    location ^~ /files/ { }
    location ~* \.(pdf|jpg|jpeg|png|gif|ico|css|js)$ {
        expires 7d;
    }

    # Block access to sensitive MediaWiki paths
    location ^~ /w/cache/       { return 403; }
    location ^~ /w/includes/    { return 403; }
    location ^~ /w/maintenance/ { return 403; }
    location ^~ /w/languages/   { return 403; }
    location ^~ /w/serialized/  { return 403; }
    location ^~ /w/tests/       { return 403; }
    location ~* /w/LocalSettings\.php$ { return 403; }

    # Deny all other PHP
    location ~ \.php$ {
        return 403;
    }
}
