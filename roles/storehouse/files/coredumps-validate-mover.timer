[Unit]
Description=Periodically validate + promote staged coredumps

[Timer]
# Sweep every 30 seconds. Uploads are infrequent but each one should
# land in the readable dropzone within a minute of completion so the
# admin watching coredumpctl on the source host can immediately turn
# around and inspect it on storehouse.
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=5s
Unit=coredumps-validate-mover.service

[Install]
WantedBy=timers.target
