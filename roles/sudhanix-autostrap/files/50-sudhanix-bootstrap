#!/bin/sh
#
# /etc/update-motd.d/50-sudhanix-bootstrap
#
# Dynamic MOTD entry that surfaces sudhanix-bootstrap.service state on every
# TTY/SSH login. Runs as part of pam_motd's update-motd hook.
#
# States:
#   - flag present                -> "Sudhanix 26 bootstrap: complete"
#   - service active (running)    -> "Sudhanix 26 bootstrap: running — see `journalctl -u sudhanix-bootstrap`"
#   - service failed              -> red banner with the recovery hint
#   - none of the above (pre-svc) -> silent (nothing printed)

FLAG=/var/lib/sudhanix/bootstrap.done
SVC=sudhanix-bootstrap.service

# Colour helpers — only emit ANSI on a real terminal.
if [ -t 1 ]; then
    RED="$(printf '\033[1;31m')"
    GREEN="$(printf '\033[1;32m')"
    YELLOW="$(printf '\033[1;33m')"
    DIM="$(printf '\033[2m')"
    RST="$(printf '\033[0m')"
else
    RED=""; GREEN=""; YELLOW=""; DIM=""; RST=""
fi

if [ -f "$FLAG" ]; then
    printf "%sSudhanix 26 bootstrap:%s %scomplete%s (%s)\n" \
        "$DIM" "$RST" "$GREEN" "$RST" "$(stat -c%y "$FLAG" 2>/dev/null | cut -d. -f1)"
    exit 0
fi

# systemctl is in /usr/bin on noble; guard against PATH oddities in pam_motd.
SYSTEMCTL=$(command -v systemctl 2>/dev/null)
[ -x "$SYSTEMCTL" ] || exit 0

STATE=$("$SYSTEMCTL" is-active "$SVC" 2>/dev/null || true)
case "$STATE" in
    active|activating)
        printf "%sSudhanix 26 bootstrap:%s %srunning%s — see %sjournalctl -u %s%s\n" \
            "$DIM" "$RST" "$YELLOW" "$RST" "$DIM" "$SVC" "$RST"
        ;;
    failed)
        printf "%s┌──────────────────────────────────────────────────────────────┐%s\n" "$RED" "$RST"
        printf "%s│  Sudhanix 26 bootstrap FAILED                                │%s\n" "$RED" "$RST"
        printf "%s│  Three attempts exhausted; the box is in an in-between state.│%s\n" "$RED" "$RST"
        printf "%s│  Recovery:                                                   │%s\n" "$RED" "$RST"
        printf "%s│    sudo journalctl -u %-39s%s\n" "$RED" "$SVC │" "$RST"
        printf "%s│    sudo systemctl reset-failed %-30s│%s\n" "$RED" "$SVC" "$RST"
        printf "%s│    sudo systemctl start %-37s│%s\n" "$RED" "$SVC" "$RST"
        printf "%s│  If storehouse is reachable now, retry should succeed.       │%s\n" "$RED" "$RST"
        printf "%s└──────────────────────────────────────────────────────────────┘%s\n" "$RED" "$RST"
        ;;
    inactive|"")
        # Pre-service (unit not yet enabled or unit removed). Silent.
        ;;
    *)
        printf "%sSudhanix 26 bootstrap:%s state=%s\n" "$DIM" "$RST" "$STATE"
        ;;
esac
