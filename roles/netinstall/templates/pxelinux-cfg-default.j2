DEFAULT menu.c32 
TIMEOUT 100
ONTIMEOUT BootLocal
PROMPT 0
NOESCAPE 1
ALLOWOPTIONS 1
PROMPT 0
menu width 80
menu rows 14
MENU TABMSGROW 24
MENU MARGIN 10
NOESCAPE 1
LABEL BootLocal
    localboot 0
    TEXT HELP
    Boot to local hard disk
    ENDTEXT
{% for m in ni_images %}
MENU BEGIN {{m.os}} {{m.type}} ({{m.arch}})
MENU TITLE {{m.os}} {{m.type}} ({{m.arch}})
    LABEL Previous
    MENU LABEL Previous Menu
    TEXT HELP
    Return to previous menu
    ENDTEXT
    MENU EXIT
    MENU SEPARATOR
    MENU INCLUDE menu/{{m.os}}-{{m.type}}-{{m.arch}}.menu
MENU END
{% endfor %}
LABEL PXE Rescue
    MENU LABEL PXE Rescue 32Bit
    MENU LABEL PXE Rescue
    KERNEL {{ni_www}}/pxerescue/vmlinuz
    INITRD {{ni_www}}/pxerescue/initrd.img
    APPEND boot=ramdisk ramroot=http://10.11.1.23/netinstall/pxerescue/rootfs.tar.xz
    TEXT HELP
    Ubuntu Xenial based rescue system
    ENDTEXT
LABEL Memtest
    MENU LABEL Memtest
    KERNEL {{ni_www}}/memdisk
    INITRD {{ni_www}}/memtest.iso
    APPEND iso raw 
    TEXT HELP
    Test your memory with memtest
    ENDTEXT
