#!/bin/bash

### DO NOT EDIT MANUALLY GENERATED BY ANSIBLE ###

IPSET="/sbin/ipset"

# groups
{% for group in timed_internet %}
{{group.label}}="{{group.ips|join(',')}}"
{% endfor %}

GROUP="${1,,}" # ${var,,} makes it lowercase
STATE="${2,,}"

case "$STATE" in
  on)
    $IPSET flush $GROUP
    ;;
  off)
    for IP in ${!GROUP//,/ } # !var expands var so that it becomes the var name
    do
      $IPSET -exist add $GROUP $IP
    done
    ;;
  *)
    echo "Usage $0 group_name {on|off}"
    exit 1
esac

