# Ansible generated, do not edit

auto lo
iface lo inet loopback
{% for iface in server_interfaces %}

{% if iface.auto %}
auto {{iface.name}}
{% endif %}
iface {{iface.name}} inet {{iface.inet}}
{% if iface.bridge is defined %}
  bridge-ifaces {{iface.bridge_members|join(' ')}}
  bridge-ports {{iface.bridge_members|join(' ')}}
{% for m in iface.bridge_members %}
  up ifconfig {{m}} up
{% endfor %}
{% endif %}
{% if iface.inet == "static" %}
  address {{iface.address}}
  netmask {{iface.netmask}}
{% if iface.gateway is defined %}
  gateway {{iface.gateway}}
{% endif %}
{% for route in iface.static_routes %}
    post-up ip route add table {{route.table}} {{route.dst}} via {{route.gw}} dev {{iface.name}}
{% endfor %}
{% endif %}
{% endfor %}
