# Ansible generated, do not edit

auto lo
iface lo inet loopback
{% for iface in server_interfaces %}
{% if iface.auto %}

auto {{iface.name}}
{% endif %}
iface {{iface.name}} inet {{iface.inet}}
{% if iface.inet == "static" %}
  address {{iface.address}}
  netmask {{iface.netmask}}
{% if iface.gateway is defined %}
  gateway {{iface.gateway}}
{% endif %}
{% endif %}
{% if static_routes is defined and static_routes[iface.name] is defined %}
  {% for route in static_routes[iface.name] %}
  post-up ip route add table {{route.table}} {{route.dst}} via {{route.gw}} dev {{route.dev}}
  {% endfor %}
{% endif %}
{% endfor %}
