---

  # Make sure p11-kit-modules is installed, which contains the needed file: p11-kit-trust.so.
  - name: install p11-kit-modules
    apt:
      name: p11-kit-modules
      state: present
      install_recommends: no

  - name: copy CTTB Root CA certificate
    copy:
      src: CTTB-Root-CA.crt
      dest: /usr/local/share/ca-certificates/CTTB-Root-CA.crt
      owner: root
      group: root
      mode: 0644
      force: yes

  - name: ca certificate | Check whether CTTB Root CA certificate is already added
    # Check whether it's already added into the all-containing file.
    shell: grep -E '^EH4GBuvisHX1r5NIV5g89uEcsYgUWw5xYi3NgfzyelOBhrUc$' /etc/ssl/certs/ca-certificates.crt | wc -l
    register: cttb-ca-cert-included

  - name: update the system-wide certificate info
    command: update-ca-certificates -f
    when: "${cttb-ca-cert-included.stdout} == 0"
    # The "-f" means "fresh". It removes all existing symlinks then regenerate them, thus can delete links for removed authorities.

  - name: create cttb-cacert.pem symlink
    file:
      src: /etc/ssl/certs/CTTB-Root-CA.pem
      dest: /etc/ssl/certs/cttb-cacert.pem
      owner: root
      group: root
      state: link

  - name: change the libnssckbi.so files to symlinks if not already, x86_64
    # If the file is not a symbolic link, back up its content. For all, forcefully change it to a link to the p11-kit-trust.so file.
    shell: ls -1 /usr/lib/firefox/libnssckbi.so /usr/lib/thunderbird/libnssckbi.so /usr/lib/x86_64-linux-gnu/nss/libnssckbi.so `locate -b '\libnssckbi.so'` | sort -u | xargs -I{} sh -c 'if [ ! -L {} ]; then cp -p {} {}.orig ; fi ; ln -f -s /usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-trust.so {}'
    when: ansible_architecture == "x86_64"
    tags:
      - gen_symlinks

  - name: change the libnssckbi.so files to symlinks if not already, i386
    # If the file is not a symbolic link, back up its content. For all, forcefully change it to a link to the p11-kit-trust.so file.
    shell: ls -1 /usr/lib/firefox/libnssckbi.so /usr/lib/thunderbird/libnssckbi.so /usr/lib/i386-linux-gnu/nss/libnssckbi.so `locate -b '\libnssckbi.so'` | sort -u | xargs -I{} sh -c 'if [ ! -L {} ]; then cp -p {} {}.orig ; fi ; ln -f -s /usr/lib/i386-linux-gnu/pkcs11/p11-kit-trust.so {}'
    when: ansible_architecture == "i386"
    tags:
      - gen_symlinks
