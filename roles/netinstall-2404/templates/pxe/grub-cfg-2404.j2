# GRUB EFI config for UEFI PXE boot (Ubuntu 24.04 autoinstall)
# Generated by Ansible — do not edit manually (source: templates/pxe/grub-cfg-2404.j2).
#
# IMPORTANT: semicolons must be escaped as \; in linux cmdline —
# GRUB treats bare ; as a statement separator.

set default=0
set timeout={{ ni_grub_timeout | default(10) }}

{% for m in ni_2404_images %}
{% set path = m.os + "/" + m.type + "-" + m.name + "-" + m.arch %}
{% for ai in m.autoinstall %}
menuentry "{{ ai.description }}" {
    linux {{ path }}/{{ m.kernel_path }} noprompt ip=dhcp ipv6.disable=1 url={{ ni_www }}/{{ m.os }}-{{ m.type }}-{{ m.name }}-{{ m.arch }}.iso autoinstall ds=nocloud\;s={{ ni_www }}/autoinstall/{{ m.os }}/{{ ai.name }}/
    initrd {{ path }}/{{ m.initrd_path }}
}

{% endfor %}
{% endfor %}

menuentry "Boot from local disk" {
    exit
}
