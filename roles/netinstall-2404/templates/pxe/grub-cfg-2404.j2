# GRUB EFI config for UEFI PXE boot (Ubuntu 24.04 autoinstall)
# Generated by Ansible — do not edit manually (source: templates/pxe/grub-cfg-2404.j2).
#
# IMPORTANT: ds= semicolon must be inside double-quotes, NOT escaped as \;
# GRUB passes \; as a literal backslash+semicolon; cloud-init never sees the datasource.
# cloud-config-url= is belt-and-suspenders in case nocloud-net ds= parsing fails.

set default=0
set timeout={{ ni_grub_timeout | default(10) }}

{% set slim = '-slim' if ni_serve_slim_iso | default(false) else '' %}
{% for m in ni_2404_images %}
{% set path = m.os + "/" + m.type + "-" + m.name + "-" + m.arch %}
{% for ai in m.autoinstall %}
menuentry "{{ ai.description }}" {
    linux {{ path }}/{{ m.kernel_path }} noprompt ip=dhcp ipv6.disable=1 url={{ ni_www }}/{{ m.os }}-{{ m.type }}-{{ m.name }}-{{ m.arch }}{{ slim }}.iso autoinstall ds="nocloud-net;s={{ ni_www }}/autoinstall/{{ m.os }}/{{ ai.name }}/" cloud-config-url={{ ni_www }}/autoinstall/{{ m.os }}/{{ ai.name }}/user-data
    initrd {{ path }}/{{ m.initrd_path }}
}

{% endfor %}
{% endfor %}

menuentry "Boot from local disk" {
    exit
}
