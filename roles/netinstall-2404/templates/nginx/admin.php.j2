<body>

<header class="site-header">
  <div class="site-title">
    <h1><span><?= h(preg_replace('/\.cttb$/', '', $SERVER_NAME)) ?></span>.cttb — PXE Admin</h1>
    <p class="subtitle">Network install control — City of Ten Thousand Buddhas</p>
  </div>
</header>

<main>

<?php if ($msg !== ''): ?>
<p class="notice"><?= h($msg) ?></p>
<?php endif; ?>

<p class="warn">
  Ansible owns the boot menus &mdash; any <code>ni_pxe_menu</code> redeploy
  <strong>re-disarms autoinstall</strong>; a full role run restarts tftpd.
  Panel changes are operational overrides, not configuration.
</p>

<div class="panel-grid">

<div class="panel">
  <h2>&#x2699; Autoinstall (reimage on boot-menu timeout)</h2>
  <p>
    State: <span class="<?= $armed ? 'state-on' : 'state-off' ?>">
      <?= $armed ? 'ARMED' : 'disarmed' ?></span>
    &mdash; BIOS default <code><?= h($ontimeout) ?></code>,
    UEFI default <code><?= h($grubdef) ?></code>
  </p>
<?php if ($mismatch): ?>
  <p class="warn">BIOS and UEFI menus disagree — one firmware class would
  reimage on timeout while the other boots local. Use a button below to make
  them consistent.</p>
<?php endif; ?>
  <form class="inline" method="post">
    <input type="hidden" name="tok" value="<?= h($tok) ?>">
    <input type="hidden" name="action" value="arm">
    <button <?= ($armed && !$mismatch) ? 'disabled' : '' ?> title="autoinstall on timeout">&#x26A1; Arm</button>
  </form>
  <form class="inline" method="post">
    <input type="hidden" name="tok" value="<?= h($tok) ?>">
    <input type="hidden" name="action" value="disarm">
    <button <?= (!$armed && !$mismatch) ? 'disabled' : '' ?> title="boot local disk on timeout">&#x1F6E1; Disarm</button>
  </form>
</div>

<div class="panel">
  <h2>&#x1F4E1; TFTP service (netboot hard block)</h2>
  <p>
    tftpd-hpa: <span class="<?= $tftpOn ? 'state-off' : 'state-on' ?>"><?= h($tftpd) ?></span>
    <?= $tftpOn ? '&mdash; clients can netboot' : '&mdash; netboot is blocked (no boot files served)' ?>
  </p>
  <form class="inline" method="post">
    <input type="hidden" name="tok" value="<?= h($tok) ?>">
    <input type="hidden" name="action" value="tftp-on">
    <button <?= $tftpOn ? 'disabled' : '' ?>>&#x25B6; Start tftpd</button>
  </form>
  <form class="inline" method="post">
    <input type="hidden" name="tok" value="<?= h($tok) ?>">
    <input type="hidden" name="action" value="tftp-off">
    <button <?= $tftpOn ? '' : 'disabled' ?>>&#x25A0; Stop tftpd</button>
  </form>
</div>

</div><!-- /panel-grid -->

<div class="panel">
  <h2>&#x1F4DC; Logs</h2>
  <form method="get" class="logform">
    <label>Source:
      <select name="src">
        <option value="tftp" <?= $src === 'tftp' ? 'selected' : '' ?>>TFTP (journal)</option>
        <option value="http" <?= $src === 'http' ? 'selected' : '' ?>>Install HTTP (/netinstall/)</option>
      </select>
    </label>
    <label>Lines: <input type="number" name="n" value="<?= h($n) ?>" min="10" max="2000" size="6"></label>
    <label>Filter: <input type="text" name="q" value="<?= h($q) ?>" size="30" placeholder="substring or regex"></label>
    <label><input type="checkbox" name="re" value="1" <?= $useRegex ? 'checked' : '' ?>> regex</label>
    <button>&#x1F50D; Show</button>
  </form>
<?php if ($logErr !== ''): ?>
  <p class="warn"><?= h($logErr) ?></p>
<?php else: ?>
  <p class="linecount"><?= count($logLines) ?> line(s)</p>
  <pre class="logbox"><?php foreach ($logLines as $l) { echo h($l), "\n"; } ?></pre>
<?php endif; ?>
</div>

</main>

<footer>
  <p>CTTB IT &mdash; authenticated as <code><?= h($_SERVER['REMOTE_USER'] ?? '?') ?></code>
     &mdash; managed via Ansible (<code>netinstall-2404</code>, tag <code>ni_admin</code>)</p>
</footer>

</body>
</html>
