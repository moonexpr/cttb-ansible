    grid-template-columns: 1fr;
  }
}
.panel { border: 1px solid #41505e; border-radius: 6px; padding: .6em .9em; margin: .5em 0; }
.panel h2 { font-size: 1.05em; margin: .1em 0 .4em; }
.panel p { margin: .3em 0 .5em; }
.state-on  { color: #d95468; font-weight: bold; }
.state-off { color: #8bd49c; font-weight: bold; }
.warn, .notice { background: #2d2b23; border: 1px solid #d98e48; padding: .35em .8em; margin: .4em 0; border-radius: 6px; font-size: .85em; }
.logform { display: flex; flex-wrap: wrap; gap: .6em; align-items: center; }
.logform label { display: inline-flex; align-items: center; gap: .35em; margin: 0; white-space: nowrap; }
