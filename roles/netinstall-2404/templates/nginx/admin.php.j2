.logform input[type=number] { width: 5.5em; }
.logform input[type=text] { width: 18em; }
.linecount { margin: .2em 0; font-size: .85em; }
.logbox { max-height: 38vh; overflow: auto; background: #1d252c; padding: .6em; margin: .3em 0 0; font-size: .85em; }
form.inline { display: inline; }
