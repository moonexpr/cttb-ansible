#cloud-config
autoinstall:
  version: 1
  locale: {{ni_locale}}
  keyboard:
    layout: {{ni_keyboard_layout}}
  network:
    version: 2
    ethernets:
      id0:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: false
{% if ni_wifi_ssid %}
    wifis:
      id1:
        match:
          name: "wl*"
        dhcp4: true
        dhcp6: false
        access-points:
{% if ni_wifi_password %}
          "{{ni_wifi_ssid}}":
            password: "{{ni_wifi_password}}"
{% else %}
          "{{ni_wifi_ssid}}": {}
{% endif %}
{% endif %}
  apt:
    preserve_sources_list: false
    mirror-selection:
      primary:
        - uri: http://{{apt_host}}/mirrors/ubuntu/
      security:
        - uri: http://{{apt_host}}/mirrors/ubuntu/
    geoip: false
  storage:
    layout:
      name: direct
  identity:
    hostname: computer
    realname: {{ni_admin_fullname}}
    username: {{ni_admin_user}}
    password: "{{ni_admin_password_crypted}}"
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - "{{ni_ansible_ssh_pubkey}}"
      - "{{ni_jc_ssh_pubkey}}"
  timezone: {{ni_timezone}}
  updates: security
  # Ansible handles the full desktop stack; PXE install is Ansible bootstrap only.
  packages:
    - openssh-server
    - python3
  # No late-commands: identity creates {{ni_admin_user}} via cloud-init on first
  # boot (default UID 1000), and ssh.authorized-keys above propagates keys via
  # cloud-init. usermod/authorized_keys writes in late-commands fail with exit 6
  # ("user doesn't exist") because cloud-init hasn't created the user yet.
  #
  # ── Second-stage autoinstaller (host-agnostic) ───────────────────────────
  # Once subiquity has installed the Ubuntu 24.04 base + cloud-init has
  # created the administrator user, the box reboots and cloud-init runs
  # again against the cloud-config below. It writes three files to disk
  # (systemd unit, bootstrap script, MOTD hook) and enables the unit so
  # network-online.target triggers the actual transformation play
  # (build-sudhanix-autobootstrap.yml — host-agnostic Sudhanix-26 roles).
  # The MOTD hook surfaces bootstrap state on every TTY/SSH login.
  # Source of truth for the embedded files: roles/sudhanix-autostrap/files/.
  # (Same role can also be applied directly via ansible to refresh a
  # already-installed box without a full PXE re-install.)
  user-data:
    write_files:
      - path: /etc/systemd/system/sudhanix-bootstrap.service
        permissions: '0644'
        owner: root:root
        content: |
{{ lookup('file', playbook_dir + '/../roles/sudhanix-autostrap/files/sudhanix-bootstrap.service') | indent(width=10, first=True) }}
      - path: /usr/local/sbin/sudhanix-bootstrap
        permissions: '0755'
        owner: root:root
        content: |
{{ lookup('file', playbook_dir + '/../roles/sudhanix-autostrap/files/sudhanix-bootstrap.sh') | indent(width=10, first=True) }}
      - path: /etc/update-motd.d/50-sudhanix-bootstrap
        permissions: '0755'
        owner: root:root
        content: |
{{ lookup('file', playbook_dir + '/../roles/sudhanix-autostrap/files/50-sudhanix-bootstrap') | indent(width=10, first=True) }}
    runcmd:
      - [ mkdir, -p, /var/lib/sudhanix ]
      - [ systemctl, daemon-reload ]
      - [ systemctl, enable, sudhanix-bootstrap.service ]
