#cloud-config
autoinstall:
  version: 1
  locale: {{ni_locale}}
  keyboard:
    layout: {{ni_keyboard_layout}}
  network:
    version: 2
    ethernets:
      id0:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: false
{% if ni_wifi_ssid %}
    wifis:
      id1:
        match:
          name: "wl*"
        dhcp4: true
        dhcp6: false
        access-points:
{% if ni_wifi_password %}
          "{{ni_wifi_ssid}}":
            password: "{{ni_wifi_password}}"
{% else %}
          "{{ni_wifi_ssid}}": {}
{% endif %}
{% endif %}
  apt:
    preserve_sources_list: false
    mirror-selection:
      primary:
        - uri: http://{{apt_host}}/mirrors/ubuntu/
      security:
        - uri: http://{{apt_host}}/mirrors/ubuntu/
    geoip: false
  storage:
    layout:
      name: direct
  identity:
    hostname: computer
    realname: {{ni_admin_fullname}}
    username: {{ni_admin_user}}
    password: "{{ni_admin_password_crypted}}"
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - "{{ni_ansible_ssh_pubkey}}"
      - "{{ni_jc_ssh_pubkey}}"
  timezone: {{ni_timezone}}
  updates: security
  # Ansible handles the full desktop stack; PXE install is Ansible bootstrap only.
  packages:
    - openssh-server
    - python3
  # late-commands here must touch /etc only. identity creates {{ni_admin_user}} via
  # cloud-init on first boot (default UID 1000), and ssh.authorized-keys above
  # propagates keys via cloud-init. usermod/authorized_keys writes in late-commands
  # fail with exit 6 ("user doesn't exist") because cloud-init hasn't created the
  # user yet.
  late-commands:
    # Stage-1 console banner, replaced by roles/common in stage 2. agetty hardcodes
    # the word "login:" and prints the hostname before it, so LOGIN_PLAIN_PROMPT
    # below drops the hostname and the issue file ends with "technician" and no
    # trailing newline, yielding "technician login:". The hostname would read
    # "computer" here anyway -- identity sets it, common renames in stage 2 -- so
    # the banner shows the DHCP address instead.
    # Escapes: \S = os-release PRETTY_NAME, \4 = first configured IPv4, \l = tty.
    # The quoted heredoc delimiter keeps those backslashes intact for agetty. The
    # printf appends without the newline a heredoc would add, and its trailing space
    # is load-bearing: agetty writes the separator space only when it prints a
    # hostname, so without it the console reads "technicianlogin:".
    - |
      cat <<'ISSUEEOF' > /target/etc/issue
      {{ni_stage1_description}} running on \S in teletype mode.
      This computer is ready for the Stage 2 installation.
      IP: \4  (\l)

      ISSUEEOF
      printf '%s' 'technician ' >> /target/etc/issue
    # login.defs is last-line-wins (util-linux lib/logindefs.c: store() prepends,
    # search() takes the head), so appending beats any stock value without a strip.
    - echo 'LOGIN_PLAIN_PROMPT yes' >> /target/etc/login.defs
