#!/bin/bash

## Setting variables with explanations.

#
# Don't touch the user's keyring, have our own instead
#
export GNUPGHOME={{dm_gpg_dir}}

# Arch=         -a      # Architecture. For Ubuntu can be i386, powerpc or amd64.
arch={{item.arch}}

# Minimum Ubuntu system requires main, restricted
# Section=      -s      # Section (One of the following - main/restricted/universe/multiverse).
#
section={{item.sections}}

# Release=      -d      # Release of the system (...Hardy, Intrepid... Lucid, Precise, Quantal, Saucy, Trusty ), and the -updates and -security ( -backports can be added if desired)
# List of updated releases in: https://wiki.ubuntu.com/Releases
#

release={{item.releases}}

# Server=       -h      # Server name, minus the protocol and the path at the end
# CHANGE "*" to equal the mirror you want to create your mirror from. au. in Australia  ca. in Canada.
# This can be found in your own /etc/apt/sources.list file, assuming you have Ubuntu installed.
#
server={{item.mirror}}

# Dir=          -r      # Path from the main server, so http://my.web.server/$dir, Server dependant
#
inPath={{item.src_path}}

# Proto=        --method=       # Protocol to use for transfer (http, ftp, hftp, rsync)
# Choose one - http is most usual the service, and the service must be avaialbe on the server you point at.
#
proto={{item.proto}}

# Outpath=              # Directory to store the mirror in
# Make this a full path to where you want to mirror the material.
#
outPath={{dm_mirrors_dir}}/{{item.dst_path}}

# The --nosource option only downloads debs and not deb-src's
# The --progress option shows files as they are downloaded
# --source \ in the place of --no-source \ if you want sources also.
# --nocleanup  Do not clean up the local mirror after mirroring is complete. Use this option to keep older repository
# Start script
#

LOG="{{dm_log_dir}}/{{item.name}}.log"
# Clear log, only keeping current/last run, no history
echo -n > ${LOG}
NOW=`date +%Y-%m-%d:%H:%M:%S`
echo "Debmirror {{item.name}} Started ${NOW}"  >> ${LOG}

debmirror -a $arch \
{% if not item.source %}
          --no-source \
{% endif %}
{% if item.rsync_options is defined %}
          --rsync-extra={{item.rsync_options}} \
{% endif %}
          -s $section \
          -h $server \
          -d $release \
          -r $inPath \
          --progress \
          --method=$proto \
          $outPath >> ${LOG}

NOW=`date +%Y-%m-%d:%H:%M:%S`
echo "Debmirror {{item.name}} Completed ${NOW}"  >> ${LOG}
