#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  network:
    version: 2
    ethernets:
      id0:
        match:
          name: "en*"
        dhcp4: true
        dhcp6: false
  apt:
    preserve_sources_list: false
    mirror-selection:
      primary:
        - uri: http://apt.cttb/mirrors/ubuntu/
    security:
      - uri: http://apt.cttb/mirrors/ubuntu
    geoip: false
  storage:
    layout:
      name: direct
  identity:
    hostname: dvgs-lab3
    realname: Administrator
    username: administrator
    password: "$1$YGmPEYhr$WDaYWLKV.dixml0kcrUr91"
  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - "ssh-rsa  ansible@cttb.us"
  timezone: US/Pacific
  updates: security
  packages:
    - openssh-server
    - python3
    - lubuntu-desktop
    - network-manager
  late-commands:
    - curtin in-target -- usermod -u 999 administrator
    - curtin in-target -- mkdir -p /home/administrator/.ssh
    - curtin in-target -- chmod 700 /home/administrator/.ssh
    - |
      cat <<'SSHEOF' > /target/home/administrator/.ssh/authorized_keys
      ssh-rsa  ansible@cttb.us
      SSHEOF
    - curtin in-target -- chown -R 999:999 /home/administrator/.ssh
    - curtin in-target -- chmod 600 /home/administrator/.ssh/authorized_keys
    - curtin in-target -- systemctl set-default graphical.target
    - |
      cat <<'NETEOF' > /target/etc/network/interfaces
      auto lo
      iface lo inet loopback
      NETEOF
