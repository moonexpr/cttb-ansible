#!/bin/sh
# Compatibility forwarder. The sysadmin toolkit moved to utils/ so it is usable
# without reference to Claude; canonical path is utils/vault-pass.
#
# exec preserves the fail-closed contract: exit 2 with nothing on stdout when
# the credential is absent, so ansible-vault never sees an empty password.
exec "$(dirname "$0")/../../utils/vault-pass" "$@"
