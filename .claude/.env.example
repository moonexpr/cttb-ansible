# cttb-ansible sysadmin toolkit — credential environment variables.
#
# Copy to .claude/.env and fill in values. .claude/.env is GITIGNORED — never committed.
#
# The toolkit reads each credential from a credential store first (macOS Keychain
# or Windows Credential Manager), then from the env vars below. macOS users can
# skip this file and store in Keychain instead:
#
#   security add-generic-password -s CTTB_VAULT_PASS -w
#   security add-generic-password -s WIKI_CTTB_BOT_USER  -a "$USER" -w
#   security add-generic-password -s WIKI_CTTB_BOT_PASSWD -a "$USER" -w
#   security add-generic-password -s CTTB_LDAP_USERNAME  -a "$USER" -w
#   security add-generic-password -s CTTB_LDAP_PASSWD   -a "$USER" -w
#
# Windows users:  cmdkey /generic:CTTB/<SERVICE> /user:. /pass:<value>
# Linux sysadmins (no Keychain): fill this file, then load it before running the
# CLIs:
#
#   set -a && source .claude/.env && set +a

# Ansible vault password — env fallback for .claude/sysadmin/vault-pass.sh when
# the macOS Keychain entry is absent (e.g. Linux sysadmin boxes).
CTTB_VAULT_PASS=

# MediaWiki bot account for .claude/sysadmin/wiki (wiki.cttb, MediaWiki 1.43).
WIKI_CTTB_BOT_USER=
WIKI_CTTB_BOT_PASSWD=

# Bind credentials for .claude/sysadmin/ldap (ldap.cttb).
# Username may be a bare uid or a full DN (e.g. cn=admin,dc=cttb).
CTTB_LDAP_USERNAME=
CTTB_LDAP_PASSWD=

# Local checkout path of the vajra source tree, used by /vajra-build
# (.claude/skills/vajra-build/scripts/publish.sh). Required for that skill.
VAJRA_SRC=