# cttb-ansible sysadmin toolkit — credential environment variables.
#
# Copy to .claude/.env and fill in values. .claude/.env is GITIGNORED — never committed.
#
# The toolkit reads each credential from the platform credential store first,
# then from the env vars below. Prefer the store — an env var leaks through
# `ps -E`, /proc/<pid>/environ, and every child process.
#
#   macOS    security add-generic-password -s <SERVICE> -a "$USER" -w
#   Windows  cmdkey /generic:CTTB/<SERVICE> /user:. /pass:<value>
#   Linux    secret-tool store --label=<SERVICE> service <SERVICE>
#
# Headless (no keyring, no login session — servers, cron, bare WSL): use the
# file store instead of this file. One secret per file, mode 0600:
#
#   mkdir -p ~/.config/cttb/secrets
#   printf '%s' '<value>' > ~/.config/cttb/secrets/<SERVICE>
#   chmod 600 ~/.config/cttb/secrets/<SERVICE>
#
# If you do use this file, load it before running the CLIs:
#
#   set -a && source .claude/.env && set +a

# NOTE: CTTB_VAULT_PASS is deliberately absent from this file.
# The Ansible vault password is resolved only through the credential store
# (or the 0600 file store above) by utils/vault-pass, which
# ansible.cfg wires in as vault_password_file. It has no env-var path.
# See docs/sysadmin-onboarding.md.

# MediaWiki bot account for utils/wiki (wiki.cttb, MediaWiki 1.43).
WIKI_CTTB_BOT_USER=
WIKI_CTTB_BOT_PASSWD=

# Bind credentials for utils/ldap (ldap.cttb).
# Username may be a bare uid or a full DN (e.g. cn=admin,dc=cttb).
CTTB_LDAP_USERNAME=
CTTB_LDAP_PASSWD=

# Local checkout path of the vajra source tree, used by /vajra-build
# (.claude/skills/vajra-build/scripts/publish.sh). Required for that skill.
VAJRA_SRC=
