---

# Order seems to matter, put bond interface last

# Network interfaces
bonding: True
server_interfaces:
  - name: bond0
    bond: True
    auto: True
    inet: manual
    mode: 802.3ad
    xmit_hash_policy: 'layer2+3'
    updelay: 300
    downdelay: 200
    lacp_rate: 1
    miimon: 100
  - name: eth0
    mac: '00:25:90:4f:98:9c'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth1
    id: 2
    mac: '00:25:90:4f:98:9d'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth2
    mac: '00:25:90:4f:98:9e'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth3
    mac: '00:25:90:4f:98:9f'
    auto: True
    inet: manual
    bond_master: bond0
  - name: lxdbr0
    auto: true
    bridge: true
    bridge_members:
      - bond0
    inet: static
    address: 10.11.1.5
    netmask: 255.255.0.0
    gateway: 10.11.1.1

zfs_pools:
  - name: data
    pool_options: 'ashift=12'
    dataset_global_options: 'compression=lz4'
    level: raidz2
    disks:
      - /dev/disk/by-id/scsi-35000c500261dc6bf
      - /dev/disk/by-id/scsi-35000c5002628cbbf
      - /dev/disk/by-id/scsi-35000c50026248bc7
      - /dev/disk/by-id/scsi-35000c5002628bfab
      - /dev/disk/by-id/scsi-35000c5002628bbc7
      - /dev/disk/by-id/scsi-35000c5002629a74f
    slog: /dev/disk/by-id/nvme-BPX_C723076C020835020742
    datasets:
      - name: lxd
        options: ''
        quota: none
      - name: logs
        options: ''
        quota: 1T
      - name: kvm
        options: ''
        quota: none
    zvols:
      - name: nfshomes
        options: ''
        size: 2T


lxc: true

lxc_storage:
  name: default
  type: zfs
  source: data/lxd

lxc_containers:
  - name: log
    image: cttb-latest
    devices:
      eth0:
        host_name: log_e0
        hwaddr: '00:16:3e:11:01:20'
        type: nic
        nictype: bridged
        parent: lxdbr0
      logs:
        path: /logs
        source: /data/logs
        type: disk
  - name: git
    image: cttb-latest
    devices:
      eth0:
        host_name: git_e0
        hwaddr: '00:16:3e:11:01:21'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: debmirror
    image: cttb-latest
    devices:
      eth0:
        host_name: debm_e0
        hwaddr: '00:16:3e:11:01:22'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: pxe
    image: cttb-latest
    devices:
      eth0:
        host_name: pxe_e0
        hwaddr: '00:16:3e:11:01:23'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: metrics
    image: cttb-latest
    devices:
      eth0:
        host_name: metrics_e0
        hwaddr: '00:16:3e:11:01:24'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: koha
    image: cttb-latest
    devices:
      eth0:
        host_name: koha_e0
        hwaddr: '00:16:3e:11:01:27'
        type: nic
        nictype: bridged
        parent: lxdbr0

kvm: true
qemu_bridge: lxdbr0
qemu_dir: /data/kvm
qemu_vms:
  - name: kvm-srv-fs
    smp: 2
    mem: 8G
    disks:
      - id: root
        file: root.raw
        index: 1
        format: raw
      - id: nfshomes
        file: /dev/zvol/data/nfshomes
        format: raw
        index: 2
    ifaces:
      - id: eth0
        mac: "52:54:00:11:01:18"

nut_mode: netserver

nut_server_address: srv-nas # only accepts ips

nut_ups:
  - name: eaton5s
    driver: usbhid-ups
    port: auto
    description: "Eaton 5S 1500VA (900W)"
    address: srv-nas
    users:
      - name: upsmon
        pass: m0n4m1
        role: master
        monitor: true
      - name: upslave
        pass: m0n1t0r4nz4
        role: slave
        monitor: false
