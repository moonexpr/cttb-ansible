---

server_interfaces:
  - name: eth0
    id: 1
    mac: '78:ac:c0:b2:89:b0'
    auto: false
    inet: manual
  - name: lxdbr0
    id: 2
    auto: true
    inet: dhcp
    bridge: true
    bridge_members:
      - eth0

lxc: true
lxc_containers:
  - name: c1
    image: cttb
    devices:
      eth0:
        host_name: c1_eth0
        hwaddr: '00:16:3e:49:72:81'
        type: nic
        nictype: bridged
        parent: lxdbr0

zfs_pools:
  - name: tank0
    pool_options: 'ashift=12'
    dataset_global_options: 'compression=lz4'
    level: ''
    disks:
      - /dev/disk/by-id/ata-WDC_WD15EARS-00Z5B1_WD-WMAVU1378390
    slog: '/dev/disk/by-id/nvme-BPX_8B71076C020835003325'
    datasets:
      - name: lxd
        options: ''
