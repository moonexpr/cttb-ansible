---

# Order seems to matter, put bond interface last

# Network interfaces
bonding: True
server_interfaces:
  - name: eth0
    mac: '00:25:90:d3:33:44'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth1
    id: 2
    mac: '00:25:90:d3:33:45'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth2
    mac: '00:25:90:d3:33:46'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth3
    mac: '00:25:90:d3:33:47'
    auto: True
    inet: manual
    bond_master: bond0
  - name: bond0
    bond: True
    auto: True
    inet: static
    slaves: "eth0 eth1 eth2 eth3"
    mode: 4
    lacp_rate: 1
    miimon: 100
    address: 10.11.1.3
    netmask: 255.255.0.0
    gateway: 10.11.1.1
