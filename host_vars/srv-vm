---

# Order seems to matter, put bond interface last

# Network interfaces
bonding: True
server_interfaces:
  - name: bond0
    bond: True
    auto: True
    inet: manual
    mode: 802.3ad
    xmit_hash_policy: 'layer2+3'
    updelay: 300
    downdelay: 200
    lacp_rate: 1
    miimon: 100
  - name: eth0
    mac: '00:25:90:d3:33:44'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth1
    id: 2
    mac: '00:25:90:d3:33:45'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth2
    mac: '00:25:90:d3:33:46'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth3
    mac: '00:25:90:d3:33:47'
    auto: True
    inet: manual
    bond_master: bond0
  - name: lxdbr0
    auto: true
    bridge: true
    bridge_members:
      - bond0
    inet: static
    address: 10.11.1.3
    netmask: 255.255.0.0
    gateway: 10.11.1.1

zfs_pools:
  - name: data
    pool_options: 'ashift=12'
    dataset_global_options: 'compression=lz4'
    level: raidz2
    disks:
      - /dev/disk/by-id/ata-Samsung_SSD_850_EVO_1TB_S2RENX0H624415Y
      - /dev/disk/by-id/ata-Samsung_SSD_850_EVO_1TB_S2RENX0H624421F
      - /dev/disk/by-id/ata-Samsung_SSD_850_EVO_1TB_S2RENX0H624424X
      - /dev/disk/by-id/ata-Samsung_SSD_850_EVO_1TB_S2RENX0H802970A
    datasets:
      - name: lxd
        options: ''

lxc: true

lxc_storage:
  name: default
  type: zfs
  source: data/lxd

lxc_containers:
  - name: ldap
    image: cttb-latest
    devices:
      eth0:
        host_name: ldap_eth0
        hwaddr: '00:16:3e:11:01:25'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: ub-adult
    image: cttb-latest
    devices:
      eth0:
        host_name: uba_eth0
        hwaddr: '00:16:3e:11:01:29'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: ub-igdvs
    image: cttb-latest
    devices:
      eth0:
        host_name: ubi_eth0
        hwaddr: '00:16:3e:11:01:28'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: cups-cttb
    image: cttb-latest
    devices:
      eth0:
        host_name: cupsc_eth0
        hwaddr: '00:16:3e:11:01:36'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: cups-dvbs
    image: cttb-latest
    devices:
      eth0:
        host_name: cupsb_eth0
        hwaddr: '00:16:3e:11:01:37'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: cups-dvgs
    image: cttb-latest
    devices:
      eth0:
        host_name: cupsg_eth0
        hwaddr: '00:16:3e:11:01:38'
        type: nic
        nictype: bridged
        parent: lxdbr0
  - name: dnsmasq
    image: cttb-latest
    devices:
      eth0:
        host_name: dmasq_eth0
        hwaddr: '00:16:3e:11:01:19'
        type: nic
        nictype: bridged
        parent: lxdbr0

nut_mode: netclient

nut_ups:
  - name: eaton5s
    address: srv-nas
    users:
      - name: upslave
        pass: m0n1t0r4nz4
        role: slave
        monitor: true
