---

# Network interfaces
server_interfaces:
  - name: lan
    id: 1
    mac: '00:25:90:d3:39:18'
    auto: True
    inet: static
    address: 10.11.1.1
    netmask: 255.255.0.0
    static_routes: []
  - name: com7
    id: 7
    mac: '00:25:90:d3:39:19'
    auto: True
    inet: static
    address: 172.30.7.2
    netmask: 255.255.255.0
    balancer:
      check_ip: 75.75.75.75
      gw: 172.30.7.1
    static_routes: []
  - name: com20
    id: 20
    mac: '00:25:90:d3:39:1a'
    auto: True
    inet: static
    address: 172.30.20.2
    netmask: 255.255.255.0
    balancer:
      check_ip: 75.75.76.76
      gw: 172.30.20.1
    static_routes:
      - table: main
        # Comcast DNS1, added to help restore routes after a power outage.
        dst: 64.74.178.100
        gw: 172.30.20.1
      - table: main
        # google.com (& family): connections via com10 often get stuck in SYN_SENT.
        dst: 216.239.32.20
        gw: 172.30.20.1
      - table: main
        # Vitelity call server.
        dst: 66.241.99.22
        gw: 172.30.20.1
      - table: main
        # Another Vitelity call server found in tcpdump.
        dst: 64.2.142.93
        gw: 172.30.20.1
      - table: main
        # portal.vitelity.net. Rui found that the IP changed to cloudflare.net and updated it on 2022-01-15. Was 64.74.178.100, now 104.18.6.30 and 104.18.7.30.
        dst: 104.18.6.30
        gw: 172.30.20.1
      - table: main
        # portal.vitelity.net.
        dst: 104.18.7.30
        gw: 172.30.20.1
  - name: com10
    id: 10
    mac: '00:25:90:d3:39:1b'
    auto: True
    inet: static
    address: 172.30.10.2
    netmask: 255.255.255.0
    balancer:
      check_ip: 75.75.76.76
      gw: 172.30.10.1
    static_routes: []

server_rt_tables:
  - {id: 7, tname: com7, weight: 10}
  - {id: 20, tname: com20, weight: 30}
  - {id: 10, tname: com10, weight: 30}

# Internet restrictions based on time handled at firewall level
