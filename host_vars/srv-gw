  - label: dvbs
    type: net
    ips:
      # 10.11.10.0/24 except for CC and student laptops
      - 10.11.10.0-10.11.10.63
      - 10.11.10.71-10.11.10.110
      - 10.11.10.126-10.11.10.140
      - 10.11.10.143-10.11.10.239
	# From 240 to 255 (last octet) are reserved for devices in BS IP range for content filtering, but do not need the timed Internet access.

    periods:
      - days: "1-5"
        on_at: "8"
        off_at: "10:30"
      - days: "1,3,5"
        on_at: "11:30"
        off_at: "16:00"
