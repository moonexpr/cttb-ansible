---

# Network interfaces
server_interfaces: [
  {name: lan, mac: '00:25:90:d3:39:18', auto: True, inet: static, address: 10.11.1.1, netmask: 255.255.0.0},
  {name: com7, mac: '00:25:90:d3:39:19', auto: True, inet: static, address: 10.11.7.111, netmask: 255.255.255.0},
  {name: com20, mac: '00:25:90:d3:39:1a', auto: True, inet: static, address: 10.11.20.111, netmask: 255.255.255.0}]

static_routes:
  com7: [
      {table: main, dst: 75.75.75.75, gw: 10.11.7.1, dev: com7}]
  com20: [
      {table: main, dst: 75.75.76.76, gw: 10.11.20.1, dev: com20}]

server_rt_tables:
  - {id: 7, tname: com7}
  - {id: 20, tname: com20}

# Internet restrictions based on time handled at firewall level
timed_internet:
  - label: dvbs
    type: net
    ips:
      - 10.11.10.0/24
    periods:
      - days: "1-5"
        on_at: "6:45"
        off_at: "7:45"
      - days: "1-5"
        on_at: "8"
        off_at: "10:25"
      - days: "1-5"
        on_at: "11:30"
        off_at: "22"
      - days: "6"
        on_at: "19"
        off_at: "22"
      - days: "7"
        on_at: "20"
        off_at: "22"
  - label: dvbs_laptops
    type: ip
    ips:
      - 10.11.31.224
      - 10.11.31.225
    periods:
      - days: "1-5"
        on_at: "7"
        off_at: "22"
      - days: "6-7"
        on_at: "8"
        off_at: "22"
  - label: dvbs_yearbook
    type: ip
    ips:
      - 10.11.21.222
    periods:
      - days: "7"
        on_at: "14"
        off_at: "16"
  - label: dvgs
    type: net
    ips:
      - 10.11.9.0/24
    periods:
      - days: "*"
        on_at: "6"
        off_at: "23"


# Content filter settings
filter_ip: 10.11.1.1

filtering_groups:
  - name: adult # this is default if no other matching
    num: 1
    ips: []
    naughtynesslimit: 400
    bypass: 300
    disablecontentscan: on
    deepurlanalysis: on 
    reportinglevel: 3
    overrides:
      - exceptionsitelist
  - name: adult_no_bypass 
    num: 2
    naughtynesslimit: 175
    bypass: 0
    disablecontentscan: on
    deepurlanalysis: on 
    reportinglevel: 3
    ips:
      - 10.11.14.65
      - 10.11.15.138
      - 10.11.30.18
      - 10.11.30.38
      - 10.11.30.251
      - 10.11.31.252
      - 10.11.28.228
      - 10.11.27.5
      - 10.11.15.24
      - 10.11.30.79
      - 10.11.30.7
      - 10.11.30.165
      - 10.11.21.178
      - 10.11.23.79
      - 10.11.22.162
      - 10.11.21.178
      - 10.11.19.53
    overrides:
      - exceptionsitelist
  - name: restricted
    num: 3
    naughtynesslimit: 50
    bypass: 0
    disablecontentscan: on
    deepurlanalysis: on 
    reportinglevel: 3
    ips:
      - 10.11.8.0/24
    overrides:
      - bannedphraselist
      - bannedregexpurllist
      - bannedsitelist
      - exceptionsitelist
      - greysitelist
      - weightedphraselist
  - name: igdvs
    num: 4
    naughtynesslimit: 75
    bypass: 0
    disablecontentscan: on
    deepurlanalysis: on 
    reportinglevel: 3
    ips:
      - 10.11.9.0/24
      - 10.11.10.0/24
    overrides:
      - bannedphraselist
      - bannedregexpurllist
      - bannedsitelist
      - exceptionsitelist
      - exceptionurllist
      - greysitelist
      - weightedphraselist

# squid tuning
cache_mem: "4096 MB"
