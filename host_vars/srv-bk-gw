---

# Order seems to matter, put bond interface last

# Network interfaces
bonding: True
server_interfaces:
  - name: bond0
    bond: True
    auto: True
    inet: manual
    mode: 802.3ad
    xmit_hash_policy: 'layer2+3'
    updelay: 300
    downdelay: 200
    lacp_rate: 1
    miimon: 100
  - name: eth0
    mac: '0c:c4:7a:0d:28:50'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth1
    id: 2
    mac: '0c:c4:7a:0d:28:51'
    auto: True
    inet: manual
    bond_master: bond0
  - name: eth2
    mac: '0c:c4:7a:0d:28:52'
    auto: True
    inet: manual
  - name: eth3
    mac: '0c:c4:7a:0d:28:53'
    auto: True
    inet: manual
  - name: lxdbr0
    auto: true
    bridge: true
    bridge_members:
      - bond0
    inet: static
    address: 10.11.1.9
    netmask: 255.255.0.0
    gateway: 10.11.1.1

zfs_pools:
  - name: data
    pool_options: 'ashift=12'
    dataset_global_options: 'compression=lz4'
    level: raidz1
    disks:
      - /dev/disk/by-id/wwn-0x5000cca22ccbb939
      - /dev/disk/by-id/wwn-0x5000cca22ccbbc74
      - /dev/disk/by-id/wwn-0x5000cca22ccc635a
      - /dev/disk/by-id/wwn-0x5000cca22cd1769f
    slog: /dev/disk/by-id/nvme-BPX_8B71076C020835003325
    datasets:
      - name: lxd
        options: ''
        quota: none

lxc: true

lxc_storage:
  name: default
  type: zfs
  source: data/lxd

