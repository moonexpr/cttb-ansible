# Content filter settings
filter_ip: 10.11.5.2

filtering_groups:
  - name: igdvs
    num: 1
    naughtynesslimit: 75
    bypass: 0
    disablecontentscan: 'on'
    deepurlanalysis: 'on' 
    reportinglevel: 3
    sslmitm: 'on'
    ips:
      - 10.11.9.0/24
      - 10.11.10.0/24
