---

# E2G SSL
enablessl: 'on'
generatedcertstart: '1500857822'
fn_rootca_crt: 'cttb-cacert.pem'
fn_rootca_key: 'root-ca-key.pem'
fn_e2g_key: 'e2g-key.pem'

# Content filter settings
filter_ip: 10.11.5.2

filtering_groups:
  - name: adult # this is default if no other matching
    num: 1
    ips: []
    naughtynesslimit: 400
    bypass: 300
    sslmitm: 'on'
    disablecontentscan: 'on'
    deepurlanalysis: 'on' 
    reportinglevel: 3
    overrides:
      - exceptionsitelist
  - name: adult_no_bypass 
    num: 2
    naughtynesslimit: 175
    bypass: 0
    disablecontentscan: 'on'
    deepurlanalysis: 'on'
    reportinglevel: 3
