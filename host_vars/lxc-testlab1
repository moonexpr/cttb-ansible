      - exceptionsitelist
  - name: restricted
    num: 3
    naughtynesslimit: 50
    bypass: 0
    disablecontentscan: 'on'
    deepurlanalysis: 'on' 
    reportinglevel: 3
    ips:
      - 10.11.8.0/24
    overrides:
      - bannedphraselist
